@model DUTResManagementSystem.ViewModels.ResidenceChangeRequestViewModel

@{
    ViewBag.Title = "Request Residence Change";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentResidence = ViewBag.CurrentResidence as DUTResManagementSystem.Models.Residence;
    var currentRoom = ViewBag.CurrentRoom as DUTResManagementSystem.Models.Room;
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-exchange-alt me-2" style="color:var(--primary)"></i>Request Residence Change</h1>
        <div class="breadcrumb-text">Submit a formal request to move to a different residence</div>
    </div>
    <a href="@Url.Action("MyResidenceChangeRequests","Student")" class="btn btn-secondary btn-sm">
        <i class="fas fa-list me-1"></i>My Requests
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">

        <!-- Current Residence Info Banner -->
        <div class="card mb-3" style="border-color:rgba(59,130,246,0.3)!important">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:48px;height:48px;border-radius:12px;
                                background:rgba(59,130,246,0.15);color:var(--primary);
                                display:flex;align-items:center;justify-content:center;
                                font-size:1.3rem;flex-shrink:0">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                    font-weight:600;letter-spacing:0.05em">Your Current Residence</div>
                        <div style="font-weight:700;color:var(--text-primary);font-size:1rem">
                            @(currentResidence?.Name ?? "Unknown Residence")
                        </div>
                        @if (currentRoom != null)
                        {
                            <div style="font-size:0.82rem;color:var(--text-secondary)">
                                <i class="fas fa-door-open me-1"></i>
                                Room @currentRoom.RoomNumber (@currentRoom.RoomType)
                                @if (currentRoom.Floor.HasValue)
                                {<span>— Floor @currentRoom.Floor</span>}
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Request Form -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-exchange-alt me-2" style="color:var(--primary)"></i>
                Residence Change Request Form
            </div>
            <div class="card-body">
                @using (Html.BeginForm("ResidenceChangeRequest", "Student",
                    FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Reason, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Reason, new
                        {
                            @class = "form-control",
                            rows = 6,
                            placeholder = "Please explain clearly why you need to move to a different residence. " +
                                                "The more detail you provide, the faster your request will be reviewed. " +
                                                "E.g. medical reasons, safety concerns, distance from campus, financial reasons.",
                            required = "required",
                            maxlength = "1000",
                            oninput = "updateCount(this)"
                        })
                        @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                        <div class="d-flex justify-content-between mt-1">
                            <span class="form-text">Be as specific as possible to help the admin make a decision.</span>
                            <span style="font-size:0.75rem;color:var(--text-muted)">
                                <span id="charCount">0</span> / 1000
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.DocumentFile, new { @class = "form-label" })
                        <input type="file" name="DocumentFile" class="form-control"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        @Html.ValidationMessageFor(m => m.DocumentFile, "", new { @class = "text-danger small" })
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i>
                            Optional. Attach a supporting document such as a medical certificate,
                            doctor's letter, or any other relevant document.
                            Accepted: PDF, Word, JPG, PNG. Max 5MB.
                        </div>
                    </div>

                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Please note:</strong> You can only have one pending request at a time.
                        The DUT admin will review your request.
                        If approved, you will be deallocated from your current residence
                        and the admin will allocate you to a new one.
                        If declined, you will stay in your current residence.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-2"></i>Submit Request
                        </button>
                        <a href="@Url.Action("MyResidenceChangeRequests","Student")"
                           class="btn btn-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Right: Info sidebar -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-question-circle me-2" style="color:var(--primary)"></i>
                What Happens Next?
            </div>
            <div class="card-body">
                @{
                    var steps = new[]
                    {
                        ("fas fa-paper-plane", "var(--primary)",
                         "You submit", "Your request is sent to the DUT admin."),
                        ("fas fa-search", "#f59e0b",
                         "Admin reviews", "The admin reads your reason and supporting documents."),
                        ("fas fa-envelope", "#8b5cf6",
                         "You are notified", "You receive an email with the decision."),
                        ("fas fa-check-circle", "#22c55e",
                         "If approved", "You are removed from your current residence and room. The admin will allocate you to a new residence."),
                        ("fas fa-times-circle", "#ef4444",
                         "If declined", "You stay in your current residence. No changes are made.")
                    };
                }
                @foreach (var (icon, color, title, desc) in steps)
                {
                    <div class="d-flex align-items-start gap-3 mb-3 pb-3"
                         style="border-bottom:1px solid var(--border-light)">
                        <div style="width:32px;height:32px;border-radius:8px;
                                    background:var(--bg-elevated);
                                    display:flex;align-items:center;justify-content:center;
                                    color:@color;flex-shrink:0;font-size:0.9rem">
                            <i class="@icon"></i>
                        </div>
                        <div>
                            <div style="font-weight:600;color:var(--text-primary);font-size:0.85rem">@title</div>
                            <div style="font-size:0.78rem;color:var(--text-secondary);margin-top:0.15rem">@desc</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Card Styles */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Form Elements */
    .form-control {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
            background: var(--bg-input) !important;
            color: var(--text-primary) !important;
        }

        .form-control::placeholder {
            color: var(--input-placeholder) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .form-text {
        color: var(--text-muted-light) !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
        padding: 0.6rem 1.25rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }

    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
        padding: 0.6rem 1.25rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            color: var(--text-primary) !important;
            transform: translateY(-1px);
        }

    /* Alerts */
    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: #ef4444 !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    .alert-warning {
        background: rgba(245,158,11,0.1) !important;
        border: 1px solid rgba(245,158,11,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-warning {
        background: #fff3cd !important;
        color: #856404 !important;
        border-color: #ffeeba !important;
    }

    /* Validation Messages */
    .text-danger {
        color: #ef4444 !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
        display: block;
    }

    .field-validation-error {
        color: #ef4444 !important;
        font-size: 0.75rem;
    }

    /* Light mode overrides */
    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .form-label {
        color: #1a1a2e;
    }

    [data-theme="light"] .text-danger {
        color: #dc3545 !important;
    }
</style>

@section Scripts {
    <script>
        function updateCount(textarea) {
            var count = document.getElementById('charCount');
            count.textContent = textarea.value.length;
            if (textarea.value.length > 900) {
                count.style.color = '#ef4444';
            } else if (textarea.value.length > 800) {
                count.style.color = '#f59e0b';
            } else {
                count.style.color = 'var(--text-muted)';
            }
        }

        // Initialize character count on page load
        document.addEventListener('DOMContentLoaded', function () {
            var textarea = document.querySelector('textarea[name="Reason"]');
            if (textarea) {
                updateCount(textarea);
            }
        });

        // Form validation
        document.querySelector('form')?.addEventListener('submit', function (e) {
            var reason = document.querySelector('textarea[name="Reason"]');
            if (reason && reason.value.trim().length < 20) {
                alert('Please provide a detailed reason for your residence change request (at least 20 characters).');
                e.preventDefault();
                return false;
            }
            return true;
        });
    </script>
}