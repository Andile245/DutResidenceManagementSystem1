﻿@model List<DUTResManagementSystem.Models.Announcement>

@{
    ViewBag.Title = "Announcements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-bullhorn me-2" style="color:var(--primary)"></i>Announcements</h1>
        <div class="breadcrumb-text">All announcements from residence management</div>
    </div>
    <a href="@Url.Action("Dashboard", "Student")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

@if (Model != null && Model.Any())
{
    foreach (var a in Model)
    {
        string pc = a.Priority == "Emergency" ? "danger" : a.Priority == "Important" ? "warning" : "info";
        string borderHex = a.Priority == "Emergency" ? "rgba(239,35,60,0.3)" : a.Priority == "Important" ? "rgba(234,179,8,0.3)" : "rgba(59,130,246,0.3)";
        string iconColor = a.Priority == "Emergency" ? "#f87171" : a.Priority == "Important" ? "#eab308" : "#60a5fa";

        <div class="card mb-4" style="border-color:@borderHex!important">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:rgba(255,255,255,0.03)!important">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;color:@iconColor">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;color:#E8E8F0">@a.Title</div>
                        <div style="font-size:0.75rem;color:#6B6B80">@a.DatePosted.ToString("dd MMM yyyy hh:mm tt")</div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-@pc">@a.Priority</span>
                </div>
            </div>
            <div class="card-body">
                <p style="color:#C8C8D8;line-height:1.7;margin-bottom:1rem">@a.Content</p>
                <div class="d-flex align-items-center justify-content-between">
                    <small style="color:#6B6B80"><i class="fas fa-user me-1"></i>Posted by @(a.Staff?.FirstName + " " + a.Staff?.LastName ?? "Administration")</small>
                    @if (a.ExpiryDate.HasValue)
                    {
                        <small style="color:#6B6B80"><i class="fas fa-clock me-1"></i>Expires: @a.ExpiryDate.Value.ToString("dd MMM yyyy")</small>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5" style="color:#6B6B80">
            <i class="fas fa-bullhorn fa-4x mb-3"></i>
            <h5>No Announcements</h5>
            <p>There are no current announcements.</p>
            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-primary mt-2">Back to Dashboard</a>
        </div>
    </div>
}