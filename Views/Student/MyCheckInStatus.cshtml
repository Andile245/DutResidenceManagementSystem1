@{
    ViewBag.Title = "My Check-In Status";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var checkIn = ViewBag.CheckIn as DUTResManagementSystem.Models.ResidenceCheckIn;
    var student = ViewBag.Student as DUTResManagementSystem.Models.Student;
    var residence = ViewBag.Residence as DUTResManagementSystem.Models.Residence;
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-qrcode me-2" style="color:var(--primary)"></i>My Check-In Status</h1>
        <div class="breadcrumb-text">
            @if (residence != null)
            {
                <i class="fas fa-building me-1"></i><strong>@residence.Name</strong>
            }
        </div>
    </div>
    <a href="@Url.Action("Dashboard", "Student")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">

        @if (residence == null)
        {
            <!-- Student not allocated to any residence yet -->
            <div class="card text-center">
                <div class="card-body py-5" style="color:var(--text-muted)">
                    <i class="fas fa-building fa-4x mb-3"></i>
                    <h5 style="color:var(--text-primary)">Not Allocated to a Residence Yet</h5>
                    <p>
                        You have not been allocated to a residence. Once the admin allocates
                        you, your building manager will generate your personal check-in QR code.
                    </p>
                </div>
            </div>
        }
        else if (checkIn == null)
        {
            <!-- Allocated but no QR code generated yet -->
            <div class="card" style="border-color:rgba(245,158,11,0.3)!important">
                <div class="card-header"
                     style="background:rgba(245,158,11,0.08)!important;
                            border-color:rgba(245,158,11,0.2)!important">
                    <i class="fas fa-clock me-2" style="color:#f59e0b"></i>
                    <strong style="color:#f59e0b">QR Code Not Generated Yet</strong>
                </div>
                <div class="card-body text-center py-5">
                    <div style="width:80px;height:80px;border-radius:50%;
                                background:rgba(245,158,11,0.15);
                                display:flex;align-items:center;justify-content:center;
                                margin:0 auto 1.5rem;font-size:2.5rem;color:#f59e0b">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <h5 style="color:var(--text-primary);margin-bottom:0.75rem">
                        Waiting for Your QR Code
                    </h5>
                    <p style="color:var(--text-secondary);max-width:400px;margin:0 auto 1.5rem">
                        You are allocated to <strong style="color:var(--text-primary)">@residence.Name</strong>
                        but your building manager has not generated your personal check-in QR code yet.
                        Please contact them to request your QR code.
                    </p>
                    <div class="alert alert-info" style="text-align:left;max-width:400px;margin:0 auto">
                        <i class="fas fa-info-circle me-2"></i>
                        Once you receive your QR code, scan it to check in and get your room allocated.
                    </div>
                </div>
            </div>
        }
        else if (!checkIn.HasCheckedIn)
        {
            <!-- QR code generated but not yet scanned -->
            <div class="card" style="border-color:rgba(59,130,246,0.3)!important">
                <div class="card-header"
                     style="background:rgba(59,130,246,0.08)!important;
                            border-color:rgba(59,130,246,0.2)!important">
                    <i class="fas fa-qrcode me-2" style="color:var(--primary)"></i>
                    <strong style="color:var(--primary)">Action Required — Scan Your QR Code</strong>
                </div>
                <div class="card-body text-center py-4">
                    <div style="width:80px;height:80px;border-radius:50%;
                                background:rgba(59,130,246,0.15);
                                display:flex;align-items:center;justify-content:center;
                                margin:0 auto 1.5rem;font-size:2.5rem;color:var(--primary)">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <h5 style="color:var(--text-primary);margin-bottom:0.75rem">
                        Your QR Code is Ready — Scan to Check In
                    </h5>
                    <p style="color:var(--text-secondary);max-width:450px;margin:0 auto 1.5rem">
                        Your building manager has generated your personal check-in QR code for
                        <strong style="color:var(--text-primary)">@residence.Name</strong>.
                        You must scan it before a room can be assigned to you.
                    </p>

                    <!-- Steps -->
                    <div class="text-start mb-4"
                         style="background:var(--bg-elevated);border-radius:12px;
                                padding:1.25rem;max-width:400px;margin:0 auto;border:1px solid var(--border-light)">
                        <div style="font-weight:700;color:var(--text-primary);margin-bottom:1rem;font-size:0.9rem">
                            How to Check In:
                        </div>
                        @{
                            var steps = new[]
                            {
                                ("fas fa-envelope", "Contact your building manager to get your personal QR code link"),
                                ("fas fa-mobile-alt", "Open the link on your phone — you will be asked to log in"),
                                ("fas fa-sign-in-alt", "Log in with your student account"),
                                ("fas fa-check-circle", "Your check-in will be recorded automatically")
                            };
                        }
                        @foreach (var (icon, text) in steps)
                        {
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div style="width:32px;height:32px;border-radius:8px;
                                            background:rgba(59,130,246,0.15);color:var(--primary);
                                            display:flex;align-items:center;justify-content:center;
                                            flex-shrink:0;font-size:0.85rem">
                                    <i class="@icon"></i>
                                </div>
                                <div style="color:var(--text-secondary);font-size:0.85rem;padding-top:6px">
                                    @text
                                </div>
                            </div>
                        }
                    </div>

                    <div style="font-size:0.78rem;color:var(--text-muted)">
                        QR code generated on @checkIn.TokenGeneratedAt.ToString("dd MMM yyyy HH:mm")
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Successfully checked in -->
            <div class="card" style="border-color:rgba(34,197,94,0.35)!important">
                <div class="card-header"
                     style="background:rgba(34,197,94,0.08)!important;
                            border-color:rgba(34,197,94,0.2)!important">
                    <i class="fas fa-check-circle me-2" style="color:#22c55e"></i>
                    <strong style="color:#22c55e">Checked In</strong>
                </div>
                <div class="card-body text-center py-4">
                    <div style="width:80px;height:80px;border-radius:50%;
                                background:rgba(34,197,94,0.15);
                                display:flex;align-items:center;justify-content:center;
                                margin:0 auto 1.5rem;font-size:2.5rem;color:#22c55e">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h4 style="color:#22c55e;font-family:'Roboto',sans-serif;
                               font-weight:700;margin-bottom:0.5rem">
                        You Are Checked In!
                    </h4>
                    <p style="color:var(--text-secondary);margin-bottom:2rem">
                        Welcome to <strong style="color:var(--text-primary)">@residence.Name</strong>.
                        Your building manager can now allocate you to a room.
                    </p>

                    <!-- Check-in details -->
                    <div class="row g-3 text-start mb-3">
                        <div class="col-md-6">
                            <div style="background:var(--bg-elevated);border-radius:10px;
                                        padding:1rem;border:1px solid var(--border-light)">
                                <div style="font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;
                                            font-weight:600;margin-bottom:0.3rem">
                                    Checked In On
                                </div>
                                <div style="font-weight:700;color:#22c55e">
                                    @checkIn.CheckInTime
                                </div>
                            </div>
                        </div>
                       
                    </div>

                    @if (student?.Room == null)
                    {
                        <div class="alert alert-warning mb-0" style="text-align:left">
                            <i class="fas fa-clock me-2"></i>
                            You are checked in but have not been assigned a room yet.
                            Your building manager will assign your room shortly.
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    <!-- Right column — summary card -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user me-2" style="color:var(--primary)"></i>My Details
            </div>
            <div class="card-body">
                <div class="mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                font-weight:600;margin-bottom:0.25rem">Student Number</div>
                    <div style="color:var(--text-primary);font-weight:600">@student.StudentNumber</div>
                </div>
                <div class="mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                font-weight:600;margin-bottom:0.25rem">Name</div>
                    <div style="color:var(--text-primary);font-weight:600">
                        @student.FirstName @student.LastName
                    </div>
                </div>
                <div class="mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                font-weight:600;margin-bottom:0.25rem">Residence</div>
                    <div style="color:@(residence != null ? "var(--text-primary)" : "var(--text-muted)");font-weight:600">
                        @(residence?.Name ?? "Not allocated")
                    </div>
                </div>
                <div class="mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                font-weight:600;margin-bottom:0.25rem">Room</div>
                    <div style="font-weight:600;color:@(student?.Room != null ? "#22c55e" : "#f59e0b")">
                        @(student?.Room != null ? "Room " + student.Room.RoomNumber : "Not yet assigned")
                    </div>
                </div>
                <div>
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;
                                font-weight:600;margin-bottom:0.25rem">Check-In Status</div>
                    @if (checkIn?.HasCheckedIn == true)
                    {
                        <span class="badge" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3)">
                            <i class="fas fa-check me-1"></i>Checked In
                        </span>
                    }
                    else if (checkIn != null)
                    {
                        <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3)">
                            <i class="fas fa-qrcode me-1"></i>QR Ready — Not Scanned
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background:var(--bg-elevated);color:var(--text-muted);border:1px solid var(--border)">
                            <i class="fas fa-clock me-1"></i>Awaiting QR Code
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card Styles */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            transform: translateY(-1px);
        }

    /* Alerts */
    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: #ef4444 !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    .alert-info {
        background: rgba(59,130,246,0.1) !important;
        border: 1px solid rgba(59,130,246,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-info {
        background: #d1ecf1 !important;
        color: #0c5460 !important;
        border-color: #bee5eb !important;
    }

    .alert-warning {
        background: rgba(245,158,11,0.1) !important;
        border: 1px solid rgba(245,158,11,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-warning {
        background: #fff3cd !important;
        color: #856404 !important;
        border-color: #ffeeba !important;
    }

    /* Light mode overrides */
    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }
</style>