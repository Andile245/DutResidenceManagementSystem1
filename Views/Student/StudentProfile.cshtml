@model DUTResManagementSystem.Models.Student

@{
    ViewBag.Title = "Student Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-circle me-2"></i>Student Profile</h4>
                </div>
                <div class="card-body">
                    <!-- Success/Error Messages -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            <div class="avatar-large mb-3">
                                <i class="fas fa-user-circle fa-5x text-primary"></i>
                            </div>
                            <h5>@Model.FirstName @Model.LastName</h5>
                            <p class="text-muted">@Model.StudentNumber</p>
                            <span class="badge bg-success">Active Student</span>
                        </div>
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">First Name</label>
                                        <p class="form-control-plaintext">@Model.FirstName</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Last Name</label>
                                        <p class="form-control-plaintext">@Model.LastName</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Email</label>
                                        <p class="form-control-plaintext">@Model.Email</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Phone Number</label>
                                        <p class="form-control-plaintext">@(Model.PhoneNumber ?? "Not provided")</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Faculty</label>
                                        <p class="form-control-plaintext">@(Model.Faculty ?? "Not specified")</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Year of Study</label>
                                        <p class="form-control-plaintext">@(Model.YearOfStudy.ToString() ?? "Not specified")</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="fw-bold">Residence Allocation</label>
                                        <p class="form-control-plaintext">
                                            @if (Model.ResidenceID != null && Model.Residence != null)
                                            {
                                                <span class="text-success">@Model.Residence.Name</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Not Allocated</span>
                                            }
                                        </p>
                                    </div>
                                </div>

                            </div>
                            <div class="form-group mb-3">
                                <label class="fw-bold">Date Registered</label>
                                <p class="form-control-plaintext">@string.Format("{0:dd MMMM yyyy}", Model.DateRegistered)</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex gap-2">
                        @Html.ActionLink("Back to Dashboard", "Dashboard", "Student", null, new { @class = "btn btn-secondary" })
                        @Html.ActionLink("Download Proof of Registration", "DownloadProofOfRegistration", "Student", null,
                            new { @class = "btn btn-success", @title = "Download PDF document" })
                        @Html.ActionLink("Email Proof of Registration", "EmailProofOfRegistration", "Student", null,
                            new { @class = "btn btn-primary", @title = "Send PDF to your email" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-large {
            width: 120px;
            height: 120px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            border-radius: 50%;
        }

        .form-control-plaintext {
            padding: 0.375rem 0;
            margin-bottom: 0;
            line-height: 1.5;
            background-color: transparent;
            border: solid transparent;
            border-width: 1px 0;
            min-height: 1.8rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                font-weight: 600;
                color: #495057;
                margin-bottom: 0.25rem;
                display: block;
            }

        .card-footer .btn {
            min-width: 180px;
        }

        .d-flex.gap-2 {
            gap: 0.5rem !important;
        }

        @@media (max-width: 768px) {
            .card-footer .d-flex {
                flex-direction: column;
            }

            .card-footer .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                $('.alert').alert('close');
            }, 5000);

            // Add loading indicators for the email button
            $('a[href*="EmailProofOfRegistration"]').click(function (e) {
                var btn = $(this);
                var originalText = btn.html();

                btn.html('<i class="fas fa-spinner fa-spin me-2"></i>Sending...');
                btn.prop('disabled', true);

                setTimeout(function () {
                    btn.html(originalText);
                    btn.prop('disabled', false);
                }, 3000);
            });
        });
    </script>
}