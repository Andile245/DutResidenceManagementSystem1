@model List<DUTResManagementSystem.Models.RoomChangeRequest>

@{
    ViewBag.Title = "My Room Change Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-exchange-alt me-2" style="color:var(--primary)"></i>My Room Change Requests</h1>
        <div class="breadcrumb-text">Track your room change requests</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("RoomChangeRequest", "Student")" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-2"></i>New Request
        </a>
        <a href="@Url.Action("Dashboard", "Student")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Pending")</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Approved")</div>
                <div class="stat-label">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(239,68,68,0.15);color:#ef4444">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Declined")</div>
                <div class="stat-label">Declined</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    foreach (var request in Model)
    {
        string bc = request.Status == "Approved" ? "success" : request.Status == "Declined" ? "danger" : "warning";
        string borderHex = bc == "success" ? "rgba(34,197,94,0.25)" : bc == "danger" ? "rgba(239,68,68,0.25)" : "rgba(245,158,11,0.25)";
        string statusColor = bc == "success" ? "#22c55e" : bc == "danger" ? "#ef4444" : "#f59e0b";
        string statusBg = bc == "success" ? "rgba(34,197,94,0.15)" : bc == "danger" ? "rgba(239,68,68,0.15)" : "rgba(245,158,11,0.15)";

        <div class="card mb-4" style="border-color:@borderHex!important">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-exchange-alt me-2" style="color:@statusColor"></i>
                    <strong style="color:var(--text-primary)">Request #@request.RequestID</strong>
                </span>
                <span class="badge" style="background:@statusBg;color:@statusColor;border:1px solid @statusColor">@request.Status</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Current Room</div>
                        <div style="font-weight:700;color:var(--text-primary)">
                            @(request.CurrentRoom != null ? "Room " + request.CurrentRoom.RoomNumber + " (" + request.CurrentRoom.RoomType + ")" : "Room info unavailable")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Date Submitted</div>
                        <div style="color:var(--text-secondary)">@request.DateRequested.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
                <div class="mb-3">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Reason</div>
                    <div style="background:var(--bg-elevated);border-radius:8px;padding:0.75rem;color:var(--text-secondary);border:1px solid var(--border-light)">@request.Reason</div>
                </div>
                @if (!string.IsNullOrEmpty(request.DocumentPath))
                {
                    <div class="mb-3">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Supporting Document</div>
                        <a href="@request.DocumentPath" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-file me-1"></i>View Document</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(request.AdminFeedback))
                {
                    <div class="mb-3">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Staff Feedback</div>
                        <div class="alert" style="background:@statusBg;border:1px solid @statusColor;color:var(--text-primary);padding:0.75rem;border-radius:8px">@request.AdminFeedback</div>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5" style="color:var(--text-muted)">
            <i class="fas fa-exchange-alt fa-4x mb-3"></i>
            <h5>No room change requests yet</h5>
            <p>You haven't submitted any room change requests.</p>
            <a href="@Url.Action("RoomChangeRequest", "Student")" class="btn btn-primary mt-2">Request a Room Change</a>
        </div>
    </div>
}

<style>
    /* Stat Cards */
    .stat-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--primary) !important;
        }

    .stat-num {
        font-family: 'Roboto', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Card */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }

    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            transform: translateY(-1px);
        }

    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

    /* Alerts */
    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    /* Light mode overrides */
    [data-theme="light"] .stat-num {
        color: #1a1a2e;
    }

    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

        [data-theme="light"] .card-header strong {
            color: #1a1a2e;
        }
</style>