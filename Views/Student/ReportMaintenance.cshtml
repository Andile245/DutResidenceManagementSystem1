@model DUTResManagementSystem.ViewModels.MaintenanceReportViewModel


@{
    ViewBag.Title = "Report Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-tools me-2" style="color:var(--primary)"></i>Report Maintenance Issue</h1>
        <div class="breadcrumb-text">Submit a maintenance request for your room or residence</div>
    </div>
    <a href="@Url.Action("Maintenance", "Student")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back to Requests
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-edit me-2" style="color:var(--primary)"></i>Maintenance Request Form
            </div>
            <div class="card-body">
                <!-- Current room info -->
                @if (ViewBag.HasRoom == true)
                {
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-door-open me-2"></i>
                        Submitting for <strong>@ViewBag.ResidenceName</strong> — Room <strong>@ViewBag.RoomNumber</strong> (@ViewBag.RoomType)
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        You have not been assigned a room yet. You can still submit a general maintenance request for your residence.
                    </div>
                }

                @using (Html.BeginForm("ReportMaintenance", "Student", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label">Room Number</label>
                        @if (ViewBag.HasRoom == true)
                        {
                            @Html.TextBoxFor(m => m.RoomNumber, new { @class = "form-control", @readonly = "readonly" })
                            <div class="form-text"><i class="fas fa-lock me-1"></i>Auto-filled from your room allocation</div>
                        }
                        else
                        {
                            @Html.TextBoxFor(m => m.RoomNumber, new { @class = "form-control", placeholder = "Enter your room number" })
                        }
                        @Html.ValidationMessageFor(m => m.RoomNumber, "", new { @class = "text-danger small" })
                    </div>

                    @Html.DropDownListFor(model => model.IssueType,
    new SelectList(Enum.GetValues(typeof(MaintenanceIssueType))),
    "-- Select Issue Type --",
    new { @class = "form-control" })

                    <div class="mb-4">
                        <label class="form-label">Issue Description *</label>
                        @Html.TextAreaFor(m => m.IssueDescription, new
                        {
                            @class = "form-control",
                            rows = 6,
                            placeholder = "Describe the issue in detail — e.g., 'The shower in the bathroom is leaking from the pipe under the basin...'",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.IssueDescription, "", new { @class = "text-danger small" })
                        <div class="form-text"><span id="charCount">0</span> / 500 characters</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Upload Image <span style="color:var(--text-muted);font-weight:400">(Optional)</span></label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                        <div class="form-text">Attach a photo of the issue to help us understand the problem faster.</div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Maintenance", "Student")" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-2"></i>Submit Report
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tips Card -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><i class="fas fa-lightbulb me-2" style="color:#f59e0b"></i>Maintenance Tips</div>
            <div class="card-body">
                <div class="d-flex align-items-start gap-3 mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(34,197,94,0.15);color:#22c55e;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="fas fa-location-dot"></i>
                    </div>
                    <div>
                        <div style="font-weight:600;color:var(--text-primary);font-size:0.88rem">Be Specific</div>
                        <div style="font-size:0.78rem;color:var(--text-muted)">Include exact location of the issue</div>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(59,130,246,0.15);color:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="fas fa-calendar"></i>
                    </div>
                    <div>
                        <div style="font-weight:600;color:var(--text-primary);font-size:0.88rem">Timeline</div>
                        <div style="font-size:0.78rem;color:var(--text-muted)">Mention when the issue started</div>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3 pb-3" style="border-bottom:1px solid var(--border-light)">
                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(34,197,94,0.15);color:#22c55e;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="fas fa-camera"></i>
                    </div>
                    <div>
                        <div style="font-weight:600;color:var(--text-primary);font-size:0.88rem">Add Photos</div>
                        <div style="font-size:0.78rem;color:var(--text-muted)">A picture is worth a thousand words</div>
                    </div>
                </div>
                <div class="alert alert-danger mt-3 mb-0 py-2" style="background:rgba(239,68,68,0.1)!important;border-color:rgba(239,68,68,0.2)!important;color:#ef4444!important">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <small>For emergencies, contact residence security immediately.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card Styles */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Form Elements */
    .form-control {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
            background: var(--bg-input) !important;
            color: var(--text-primary) !important;
        }

        .form-control[readonly] {
            background: var(--bg-elevated) !important;
            cursor: not-allowed;
        }

        .form-control::placeholder {
            color: var(--input-placeholder) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .form-text {
        color: var(--text-muted-light) !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
        padding: 0.6rem 1.25rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }

    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
        padding: 0.6rem 1.25rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            color: var(--text-primary) !important;
            transform: translateY(-1px);
        }

    /* Alerts */
    .alert-info {
        background: rgba(59,130,246,0.1) !important;
        border: 1px solid rgba(59,130,246,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-info {
        background: #d1ecf1 !important;
        color: #0c5460 !important;
        border-color: #bee5eb !important;
    }

    .alert-warning {
        background: rgba(245,158,11,0.1) !important;
        border: 1px solid rgba(245,158,11,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-warning {
        background: #fff3cd !important;
        color: #856404 !important;
        border-color: #ffeeba !important;
    }

    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: #ef4444 !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    /* Validation Messages */
    .text-danger {
        color: #ef4444 !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
        display: block;
    }

    .field-validation-error {
        color: #ef4444 !important;
        font-size: 0.75rem;
    }

    /* Light mode overrides */
    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .form-label {
        color: #1a1a2e;
    }

    [data-theme="light"] .text-danger {
        color: #dc3545 !important;
    }
</style>

@section Scripts {
    <script>
        var textarea = document.querySelector('textarea[name="IssueDescription"]');
        var counter = document.getElementById('charCount');
        if (textarea && counter) {
            // Set initial count
            counter.textContent = textarea.value.length;
            counter.style.color = textarea.value.length > 450 ? '#ef4444' : 'var(--text-muted)';

            textarea.addEventListener('input', function () {
                counter.textContent = this.value.length;
                if (this.value.length > 450) {
                    counter.style.color = '#ef4444';
                } else if (this.value.length > 400) {
                    counter.style.color = '#f59e0b';
                } else {
                    counter.style.color = 'var(--text-muted)';
                }
            });
        }

        // Form validation
        document.querySelector('form')?.addEventListener('submit', function (e) {
            var description = document.querySelector('textarea[name="IssueDescription"]');
            if (description && description.value.trim().length < 10) {
                alert('Please provide a detailed description of the issue (at least 10 characters).');
                e.preventDefault();
                return false;
            }
            return true;
        });
    </script>
}