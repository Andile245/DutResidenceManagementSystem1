@model List<DUTResManagementSystem.ViewModels.VisitorRecordViewModel>

@{
    ViewBag.Title = "Active Visitors";
}

<div class="container-fluid py-4">
    <div class="page-header">
        <div>
            <h1><i class="fas fa-users me-2" style="color: var(--primary);"></i>Visitors Currently Inside</h1>
            <div class="breadcrumb-text">Live residence occupancy based on entry and exit scans</div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CheckIn", "Visitor")" class="btn btn-primary">
                <i class="fas fa-barcode me-2"></i>Scan Visitor
            </a>
            <a href="@Url.Action("Dashboard", "Visitor")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon red">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count</div>
                    <div class="stat-label">Active Visitors</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon yellow">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(v => v.CurrentStatus == "Curfew Reached")</div>
                    <div class="stat-label">Curfew Alerts</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(v => v.CurrentStatus == "Inside")</div>
                    <div class="stat-label">Regular Visitors</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fas fa-door-open"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Select(v => v.RoomNumber).Distinct().Count()</div>
                    <div class="stat-label">Rooms Occupied</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="fas fa-list me-2" style="color: var(--primary);"></i>
                Active Visitor List
            </span>
            <span class="badge bg-primary">@Model.Count Total</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="activeVisitorsTable">
                        <thead>
                            <tr>
                                <th>Visitor</th>
                                <th>Student</th>
                                <th>Room</th>
                                <th>Timeline</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visitor in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold" style="color: var(--text-primary);">@visitor.FullName</div>
                                        <div class="small text-muted">@visitor.IDNumber</div>
                                    </td>
                                    <td>
                                        <span style="color: var(--text-secondary);">@visitor.StudentDisplayName</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@visitor.RoomNumber</span>
                                    </td>
                                    <td class="small">
                                        <div><i class="fas fa-ticket-alt me-1 text-muted"></i> Pass: @visitor.PassCreatedAt.ToString("dd MMM HH:mm")</div>
                                        <div><i class="fas fa-sign-in-alt me-1 text-muted"></i> Entry: @(visitor.EntryTime.HasValue ? visitor.EntryTime.Value.ToString("dd MMM HH:mm") : "-")</div>
                                    </td>
                                    <td>
                                        @if (visitor.CurrentStatus == "Curfew Reached")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-bell me-1"></i>Curfew Reached
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>Inside
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("ManualCheckOut", "Visitor", new { id = visitor.VisitorID })"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Check out @visitor.FullName? This will log their exit time and mark them as departed.')">
                                            <i class="fas fa-sign-out-alt me-1"></i>Manual Exit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-user-check fa-4x mb-3"></i>
                    <h5>No Active Visitors</h5>
                    <p class="mb-0">There are currently no visitors inside the residence.</p>
                    <a href="@Url.Action("CheckIn", "Visitor")" class="btn btn-primary mt-3">
                        <i class="fas fa-barcode me-2"></i>Scan Visitor
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#activeVisitorsTable').DataTable({
                pageLength: 15,
                order: [[3, 'desc']],
                language: {
                    search: "<i class='fas fa-search'></i> Search:",
                    searchPlaceholder: "Search visitors...",
                    lengthMenu: "Show _MENU_ visitors",
                    info: "Showing _START_ to _END_ of _TOTAL_ visitors",
                    infoEmpty: "No visitors found",
                    infoFiltered: "(filtered from _MAX_ total visitors)",
                    emptyTable: "No active visitors at this time"
                },
                columnDefs: [
                    { orderable: false, targets: [4, 5] }
                ]
            });
        });

        // Auto-refresh every 30 seconds (optional)
        // setInterval(function() { location.reload(); }, 30000);
    </script>
}

<style>
    /* Additional styles for better table readability */
    .dataTables_wrapper .dataTables_filter input {
        margin-left: 0.5rem;
        padding: 0.375rem 0.75rem;
        border-radius: 8px;
    }

    .dataTables_wrapper .dataTables_length select {
        border-radius: 8px;
        padding: 0.25rem 0.5rem;
    }

    .table td {
        vertical-align: middle;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    code {
        background: var(--bg-elevated);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.75rem;
        color: var(--text-primary);
    }
</style>