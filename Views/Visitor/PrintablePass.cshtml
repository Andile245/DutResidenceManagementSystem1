@model DUTResManagementSystem.ViewModels.VisitorRecordViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visitor Pass - @Model.FullName</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Roboto', sans-serif;
            background: #f0f2f5;
            padding: 24px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pass-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .pass-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.15);
            transition: transform 0.2s ease;
        }

            .pass-card:hover {
                transform: translateY(-2px);
            }

        /* Header Section */
        .pass-header {
            background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
            color: white;
            padding: 28px 32px;
            position: relative;
            overflow: hidden;
        }

            .pass-header::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 200px;
                height: 200px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 50%;
            }

            .pass-header::after {
                content: '';
                position: absolute;
                bottom: -30%;
                left: -10%;
                width: 150px;
                height: 150px;
                background: rgba(255, 255, 255, 0.03);
                border-radius: 50%;
            }

        .badge-pill {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .pass-header h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 8px 0 0 0;
            letter-spacing: -0.5px;
        }

        /* Body Section */
        .pass-body {
            padding: 32px;
            background: white;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 24px;
        }

        .info-group {
            margin-bottom: 0;
        }

        .info-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            color: #6c757d;
            margin-bottom: 6px;
        }

        .info-value {
            font-size: 15px;
            font-weight: 600;
            color: #1a1a2e;
            word-break: break-word;
        }

        /* QR Code Section */
        .qr-section {
            background: #f8f9fa;
            border-radius: 16px;
            padding: 24px;
            text-align: center;
            border: 1px solid #e9ecef;
        }

        .qr-code {
            margin-bottom: 12px;
            display: inline-block;
        }

            .qr-code svg {
                width: 180px;
                height: 180px;
                border-radius: 12px;
            }

        .qr-code-text {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            background: white;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
            display: inline-block;
            word-break: break-all;
            max-width: 100%;
        }

        /* Document Image */
        .document-section {
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #e9ecef;
        }

        .document-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: #6c757d;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .document-image {
            max-width: 100%;
            border-radius: 12px;
            border: 1px solid #dee2e6;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-inside {
            background: #d4edda;
            color: #155724;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-curfew {
            background: #f8d7da;
            color: #721c24;
        }

        .status-exited {
            background: #e2e3e5;
            color: #383d41;
        }

        /* Actions */
        .pass-actions {
            text-align: center;
            margin-top: 20px;
        }

        .btn-print {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-print:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(29, 78, 216, 0.4);
            }

            .btn-print:active {
                transform: translateY(0);
            }

        /* Footer */
        .pass-footer {
            background: #f8f9fa;
            padding: 16px 32px;
            text-align: center;
            border-top: 1px solid #e9ecef;
            font-size: 11px;
            color: #6c757d;
        }

        /* Print Styles */
        @@media print {
            body {
                background: white;
                padding: 0;
                margin: 0;
            }

            .pass-container {
                max-width: 100%;
                margin: 0;
            }

            .pass-card {
                box-shadow: none;
                border-radius: 0;
            }

            .pass-actions {
                display: none;
            }

            .pass-card:hover {
                transform: none;
            }

            .btn-print {
                display: none;
            }

            .pass-header {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .status-badge {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .qr-section {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

        /* Responsive */
        @@media (max-width: 640px) {
            body {
                padding: 12px;
            }

            .info-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .pass-header {
                padding: 20px;
            }

                .pass-header h1 {
                    font-size: 22px;
                }

            .pass-body {
                padding: 20px;
            }

            .qr-code svg {
                width: 150px;
                height: 150px;
            }
        }
    </style>
</head>
<body>
    <div class="pass-container">
        <div class="pass-card">
            <!-- Header -->
            <div class="pass-header">
                <div class="badge-pill">
                    <i class="fas fa-shield-alt" style="margin-right: 6px;"></i>DUT Residence Security
                </div>
                <h1>Visitor Pass</h1>
                <p style="font-size: 13px; opacity: 0.8; margin-top: 8px;">Scan once for entry, then scan again for exit</p>
            </div>

            <!-- Body -->
            <div class="pass-body">
                <div class="info-grid">
                    <!-- Left Column -->
                    <div class="info-group">
                        <div class="info-label">Visitor Name</div>
                        <div class="info-value">@Model.FullName</div>

                        <div class="info-label" style="margin-top: 16px;">ID Number</div>
                        <div class="info-value">@Model.IDNumber</div>

                        <div class="info-label" style="margin-top: 16px;">Document Type</div>
                        <div class="info-value">@Model.DocumentType</div>

                        <div class="info-label" style="margin-top: 16px;">Pass Created</div>
                        <div class="info-value">@Model.PassCreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>

                    <!-- Right Column -->
                    <div class="info-group">
                        <div class="info-label">Student Host</div>
                        <div class="info-value">@Model.StudentDisplayName</div>

                        <div class="info-label" style="margin-top: 16px;">Room Number</div>
                        <div class="info-value">Room @Model.RoomNumber</div>

                        <div class="info-label" style="margin-top: 16px;">Current Status</div>
                        <div class="info-value">
                            @{
                                var statusClass = Model.CurrentStatus == "Inside" ? "status-inside" :
                                                 Model.CurrentStatus == "Curfew Reached" ? "status-curfew" :
                                                 Model.CurrentStatus == "Pending Entry" ? "status-pending" : "status-exited";
                            }
                            <span class="status-badge @statusClass">@Model.CurrentStatus</span>
                        </div>
                    </div>
                </div>

                <!-- QR Code Section -->
                <div class="qr-section">
                    <div class="qr-code">
                        @Html.Raw(Model.QrCodeSvg)
                    </div>
                    <div style="font-size: 11px; color: #6c757d; margin-top: 8px;">
                        <i class="fas fa-qrcode"></i> Visitor must scan this QR code to log entry and scan it again to log exit
                    </div>
                </div>

                <!-- Visiting Hours Notice -->
                <div style="margin-top: 24px; padding: 12px; background: #fff3cd; border-radius: 8px; border-left: 3px solid #ffc107;">
                    <div style="font-size: 12px; color: #856404;">
                        <i class="fas fa-clock"></i> <strong>Visiting Hours:</strong> 08:00 - 00:00
                    </div>
                    <div style="font-size: 11px; color: #856404; margin-top: 4px;">
                        Visitors must exit before 00:00. Late check-outs will trigger a curfew notification.
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="pass-footer">
                <i class="fas fa-building"></i> Durban University of Technology - Residence Management System
            </div>
        </div>

        <!-- Actions -->
        <div class="pass-actions">
            <button onclick="window.print()" class="btn-print">
                <i class="fas fa-print"></i> Print Visitor Pass
            </button>
            <button onclick="window.close()" class="btn-print" style="background: #6c757d; box-shadow: none; margin-left: 10px;">
                <i class="fas fa-times"></i> Close
            </button>
        </div>
    </div>

    <!-- Font Awesome for icons (optional print-safe) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</body>
</html>
