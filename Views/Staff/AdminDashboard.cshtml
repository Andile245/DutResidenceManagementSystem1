@model DUTResManagementSystem.ViewModels.StaffDashboardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1><i class="fas fa-tachometer-alt me-2" style="color:var(--primary)"></i>Admin Dashboard</h1>
        <div class="breadcrumb-text">Welcome back, @Model.Staff.FirstName @Model.Staff.LastName</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge" style="background:rgba(59,130,246,0.15);color:var(--primary);border:1px solid rgba(59,130,246,0.3);padding:0.5rem 0.75rem;">
            <i class="fas fa-shield-alt me-1"></i>@Model.Staff.Role
        </span>
        <span class="badge" style="background:var(--bg-elevated);color:var(--text-muted);border:1px solid var(--border);padding:0.5rem 0.75rem;">
            @Model.Staff.StaffNumber
        </span>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.15);color:var(--primary)">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Residences.Count</div>
                <div class="stat-label">Residences</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b">
                <i class="fas fa-bullhorn"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Announcements.Count</div>
                <div class="stat-label">Announcements</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-bolt me-2" style="color:var(--primary)"></i>Quick Actions
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <a href="@Url.Action("ManageResidences", "Staff")" class="action-card">
                    <div class="action-card-icon" style="background:rgba(59,130,246,0.15);color:var(--primary)">
                        <i class="fas fa-building"></i>
                    </div>
                    <h6>Manage Residences</h6>
                    <p>Add, edit or remove residences</p>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="@Url.Action("StudentAllocation", "Staff")" class="action-card">
                    <div class="action-card-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h6>Student Allocation</h6>
                    <p>Allocate students to residences</p>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="@Url.Action("SendAnnouncement", "Staff")" class="action-card">
                    <div class="action-card-icon" style="background:rgba(59,130,246,0.15);color:var(--primary)">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <h6>Send Announcement</h6>
                    <p>Create announcements for everyone</p>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="@Url.Action("ResidenceChangeRequests", "Staff")" class="action-card">
                    <div class="action-card-icon" style="background:rgba(139,92,246,0.15);color:#8b5cf6">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <h6>Residence Changes</h6>
                    <p>Review residence change requests</p>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Announcements -->
<div class="row g-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-bullhorn me-2" style="color:var(--primary)"></i>Recent Announcements</span>
                <a href="@Url.Action("ViewAnnouncements","Staff")" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Announcements.Any())
                {
                    foreach (var a in Model.Announcements.Take(5))
                    {
                        string priorityBg = a.Priority == "Emergency" ? "rgba(239,68,68,0.15)" : a.Priority == "Important" ? "rgba(245,158,11,0.15)" : "rgba(59,130,246,0.15)";
                        string priorityColor = a.Priority == "Emergency" ? "#ef4444" : a.Priority == "Important" ? "#f59e0b" : "var(--primary)";

                        <div class="d-flex align-items-start gap-3 p-3" style="border-bottom:1px solid var(--border-light)">
                            <div style="width:8px;height:8px;border-radius:50%;background:var(--primary);margin-top:6px;flex-shrink:0"></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <div style="font-weight:600;color:var(--text-primary);font-size:0.9rem">@a.Title</div>
                                        <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem">
                                            <i class="far fa-calendar-alt me-1"></i>@string.Format("{0:dd MMM yyyy}", a.DatePosted) —
                                            <i class="fas fa-users me-1"></i>@a.TargetAudience
                                        </div>
                                    </div>
                                    <span class="badge" style="background:@priorityBg;color:@priorityColor;border:1px solid @priorityColor">@a.Priority</span>
                                </div>
                                @if (!string.IsNullOrEmpty(a.Content) && a.Content.Length > 100)
                                {
                                    <div style="font-size:0.82rem;color:var(--text-secondary);margin-top:0.5rem">
                                        @a.Content.Substring(0, Math.Min(100, a.Content.Length))...
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(a.Content))
                                {
                                    <div style="font-size:0.82rem;color:var(--text-secondary);margin-top:0.5rem">@a.Content</div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5" style="color:var(--text-muted)">
                        <i class="fas fa-bullhorn fa-3x mb-3"></i>
                        <h5>No announcements yet</h5>
                        <p>Create your first announcement to keep students and staff informed.</p>
                        <a href="@Url.Action("SendAnnouncement","Staff")" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus me-1"></i>Create Announcement
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Stat Cards */
    .stat-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--primary) !important;
        }

    .stat-num {
        font-family: 'Roboto', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Action Cards */
    .action-card {
        background: var(--bg-elevated) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1rem;
        text-align: center;
        text-decoration: none;
        color: var(--text-secondary);
        display: block;
        transition: all 0.2s;
    }

        .action-card:hover {
            border-color: var(--primary) !important;
            background: var(--primary-light) !important;
            transform: translateY(-3px);
            color: var(--text-primary);
        }

    .action-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin: 0 auto 0.75rem;
    }

    .action-card h6 {
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.3rem;
        font-size: 0.85rem;
    }

    .action-card p {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* Card */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
        }

    /* Light mode overrides */
    [data-theme="light"] .stat-num {
        color: #1a1a2e;
    }

    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .action-card h6 {
        color: #1a1a2e;
    }
</style>