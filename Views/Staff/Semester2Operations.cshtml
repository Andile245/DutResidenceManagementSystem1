@model DUTResManagementSystem.ViewModels.Semester2OperationsViewModel

@{
    ViewBag.Title = "Semester 2 Operations";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-project-diagram me-2" style="color:var(--primary)"></i>Semester 2 Operations</h1>
        <div class="breadcrumb-text">@Model.ResidenceName - workflow monitoring, escalation, roll call, inspections and alerts</div>
    </div>
    <a href="@Url.Action("Dashboard", "Staff")" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon red"><i class="fas fa-tools"></i></div>
            <div>
                <div class="stat-num">@Model.EscalatedMaintenance.Count</div>
                <div class="stat-label">SLA Escalations</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon yellow"><i class="fas fa-bullhorn"></i></div>
            <div>
                <div class="stat-num">@Model.EscalatedComplaints.Count</div>
                <div class="stat-label">Complaint Escalations</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="fas fa-user-clock"></i></div>
            <div>
                <div class="stat-num">@Model.VisitorExceptions.Count</div>
                <div class="stat-label">Visitor Exceptions</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="fas fa-clipboard-check"></i></div>
            <div>
                <div class="stat-num">@Model.OpenRollCalls.Count</div>
                <div class="stat-label">Open Roll Calls</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-bolt me-2"></i>Workflow Actions</div>
            <div class="card-body d-grid gap-2">
                @using (Html.BeginForm("RunMaintenanceEscalation", "Staff", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary w-100" type="submit">
                        <i class="fas fa-stopwatch me-2"></i>Run Maintenance SLA Escalation
                    </button>
                }
                @using (Html.BeginForm("RunComplaintEscalation", "Staff", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary w-100" type="submit">
                        <i class="fas fa-level-up-alt me-2"></i>Run Complaint Escalation
                    </button>
                }
                <a href="@Url.Action("RoomInspection", "Staff")" class="btn btn-outline-primary">
                    <i class="fas fa-door-open me-2"></i>Capture Room Inspection
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-shield-alt me-2"></i>Emergency Roll Call</div>
            <div class="card-body">
                @using (Html.BeginForm("StartEmergencyRollCall", "Staff", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Incident Title</label>
                        <input name="incidentTitle" class="form-control" value="Emergency Roll Call" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="incidentNotes" class="form-control" rows="3"></textarea>
                    </div>
                    <button class="btn btn-danger w-100" type="submit">
                        <i class="fas fa-play me-2"></i>Start Roll Call
                    </button>
                }
                @if (Model.OpenRollCalls.Any())
                {
                    <hr />
                    foreach (var roll in Model.OpenRollCalls)
                    {
                        <a class="d-block mb-1" href="@Url.Action("EmergencyRollCallDetails", "Staff", new { id = roll.EmergencyRollCallID })">
                            #@roll.EmergencyRollCallID - @roll.IncidentTitle
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-bell me-2"></i>Targeted Alert</div>
            <div class="card-body">
                @using (Html.BeginForm("SendTargetedResidenceAlert", "Staff", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Audience</label>
                        <select name="audience" class="form-select">
                            <option value="Students">Students</option>
                            <option value="Staff">Staff</option>
                            <option value="Everyone">Everyone</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Title</label>
                        <input name="title" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="message" class="form-control" rows="3"></textarea>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="fas fa-paper-plane me-2"></i>Send Alert
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="fas fa-chart-line me-2"></i>Occupancy Forecast</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Residence</th>
                        <th>Capacity</th>
                        <th>Occupied</th>
                        <th>Pending Demand</th>
                        <th>Available</th>
                        <th>Risk</th>
                        <th>Recommendation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OccupancyForecast)
                    {
                        <tr>
                            <td>@item.ResidenceName</td>
                            <td>@item.Capacity</td>
                            <td>@item.Occupied (@item.OccupancyRate%)</td>
                            <td>@item.PendingApplications</td>
                            <td>@item.AvailableSpaces</td>
                            <td><span class="badge bg-@(item.RiskLevel == "High" ? "danger" : item.RiskLevel == "Medium" ? "warning" : "success")">@item.RiskLevel</span></td>
                            <td>@item.Recommendation</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-tools me-2"></i>Escalated Maintenance</div>
            <div class="card-body">
                @if (!Model.EscalatedMaintenance.Any())
                {
                    <p class="text-muted mb-0">No escalated maintenance items.</p>
                }
                @foreach (var item in Model.EscalatedMaintenance)
                {
                    <div class="border rounded p-2 mb-2">
                        <strong>#@item.MaintenanceID - @item.IssueType</strong>
                        <div class="small">Room @item.RoomNumber - @item.Priority - @item.Status</div>
                        <div class="small text-muted">@item.EscalationReason</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-bullhorn me-2"></i>Escalated Complaints</div>
            <div class="card-body">
                @if (!Model.EscalatedComplaints.Any())
                {
                    <p class="text-muted mb-0">No escalated complaints.</p>
                }
                @foreach (var item in Model.EscalatedComplaints)
                {
                    <div class="border rounded p-2 mb-2">
                        <strong>#@item.ComplaintId - @item.Subject</strong>
                        <div class="small">@item.Category - @item.Priority - @item.Status</div>
                        <div class="small text-muted">@item.EscalationReason</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
