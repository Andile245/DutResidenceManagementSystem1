@model DUTResManagementSystem.ViewModels.UserDetailsViewModel

@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-users-cog me-2" style="color:var(--primary)"></i>User Management</h1>
        <div class="breadcrumb-text">View and manage all system users</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Students -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-user-graduate me-2" style="color:var(--primary)"></i>Students</span>
        <span class="badge" style="background:var(--primary-light);color:var(--primary)">@Model.Students.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0" id="studentsTable">
                <thead>
                    <tr>
                        <th>Student #</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Faculty</th>
                        <th>Gender</th>
                        <th>Residence</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        string genderBg = student.Gender == "Male" ? "rgba(59,130,246,0.15)" : student.Gender == "Female" ? "rgba(236,72,153,0.15)" : "rgba(107,114,128,0.15)";
                        string genderColor = student.Gender == "Male" ? "var(--primary)" : student.Gender == "Female" ? "#ec4899" : "var(--text-muted)";

                        <tr>
                            <td style="color:var(--text-secondary);font-size:0.82rem">@student.StudentNumber</td>
                            <td style="font-weight:600;color:var(--text-primary)">@student.FirstName @student.LastName</td>
                            <td style="font-size:0.82rem;color:var(--text-muted)">@student.Email</td>
                            <td style="font-size:0.78rem;color:var(--text-secondary)">@student.Faculty</td>
                            <td>
                                <span class="badge" style="background:@genderBg;color:@genderColor;border:1px solid @genderColor">@student.Gender</span>
                            </td>
                            <td style="font-size:0.82rem;color:var(--text-secondary)">@(student.Residence?.Name ?? "—")</td>
                            <td>
                                <span class="badge" style="background:@(student.IsActive ? "rgba(34,197,94,0.15)" : "rgba(239,68,68,0.15)");color:@(student.IsActive ? "#22c55e" : "#ef4444");border:1px solid @(student.IsActive ? "#22c55e" : "#ef4444")">
                                    @(student.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editStudent('@student.StudentID')" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm @(student.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="toggleStudentStatus('@student.StudentID', @student.IsActive.ToString().ToLower())"
                                            title="@(student.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas @(student.IsActive ? "fa-times" : "fa-check")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Staff -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-user-tie me-2" style="color:var(--primary)"></i>Building Managers &amp; Administrators</span>
        <span class="badge" style="background:var(--primary-light);color:var(--primary)">@Model.Staff.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0" id="staffTable">
                <thead>
                    <tr>
                        <th>Staff #</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.Staff)
                    {
                        <tr>
                            <td style="color:var(--text-secondary);font-size:0.82rem">@staff.StaffNumber</td>
                            <td style="font-weight:600;color:var(--text-primary)">@staff.FirstName @staff.LastName</td>
                            <td style="font-size:0.82rem;color:var(--text-muted)">@staff.Email</td>
                            <td>
                                <span class="badge" style="background:@(staff.Role=="Admin" ? "rgba(59,130,246,0.15)" : "rgba(107,114,128,0.15)");color:@(staff.Role=="Admin" ? "var(--primary)" : "var(--text-secondary)");border:1px solid @(staff.Role=="Admin" ? "var(--primary)" : "var(--border-color)")">
                                    @staff.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge" style="background:@(staff.IsActive ? "rgba(34,197,94,0.15)" : "rgba(239,68,68,0.15)");color:@(staff.IsActive ? "#22c55e" : "#ef4444");border:1px solid @(staff.IsActive ? "#22c55e" : "#ef4444")">
                                    @(staff.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editStaff('@staff.StaffID')" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm @(staff.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="toggleStaffStatus('@staff.StaffID', @staff.IsActive.ToString().ToLower())"
                                            title="@(staff.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas @(staff.IsActive ? "fa-times" : "fa-check")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-edit me-2" style="color:var(--primary)"></i>Edit Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("EditStudent", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="editStudentId" name="studentId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" id="editFirstName" name="firstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" id="editLastName" name="lastName" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" id="editEmail" name="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender *</label>
                            <select class="form-select" id="editGender" name="gender" required>
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Faculty *</label>
                            <select class="form-select" id="editFaculty" name="faculty" required>
                                <option value="">Select Faculty</option>
                                <option value="Accounting and Informatics">Accounting &amp; Informatics</option>
                                <option value="Applied Sciences">Applied Sciences</option>
                                <option value="Arts and Design">Arts &amp; Design</option>
                                <option value="Engineering and the Built Environment">Engineering</option>
                                <option value="Health Sciences">Health Sciences</option>
                                <option value="Management Sciences">Management Sciences</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Year of Study *</label>
                            <input type="number" class="form-control" id="editYearOfStudy" name="yearOfStudy" min="1" max="4" required>
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="hidden" name="isActive" value="false" />
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" value="true" style="accent-color:var(--primary)">
                        <label class="form-check-label" for="editIsActive" style="color:var(--text-secondary)">Active Account</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Staff Modal -->
<div class="modal fade" id="editStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-edit me-2" style="color:var(--primary)"></i>Edit Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("EditStaff", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="editStaffId" name="staffId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" id="editStaffFirstName" name="firstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" id="editStaffLastName" name="lastName" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" id="editStaffEmail" name="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Role *</label>
                            <select class="form-select" id="editStaffRole" name="role" required>
                                <option value="">Select Role</option>
                                <option value="Admin">Admin</option>
                                <option value="Building Manager">Building Manager</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="hidden" name="isActive" value="false" />
                        <input class="form-check-input" type="checkbox" id="editStaffIsActive" name="isActive" value="true" style="accent-color:var(--primary)">
                        <label class="form-check-label" for="editStaffIsActive" style="color:var(--text-secondary)">Active Account</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Card */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Table */
    .table {
        color: var(--text-secondary) !important;
    }

        .table thead th {
            background: var(--bg-elevated) !important;
            color: var(--text-primary) !important;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-color: var(--border-light) !important;
            font-weight: 600;
        }

        .table tbody tr {
            border-color: var(--border-light) !important;
        }

            .table tbody tr:hover {
                background: var(--table-hover) !important;
            }

        .table td, .table th {
            border-color: var(--border-light) !important;
            color: var(--text-secondary);
        }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

    .btn-outline-danger {
        color: #ef4444 !important;
        border-color: #ef4444 !important;
    }

        .btn-outline-danger:hover {
            background: #ef4444 !important;
            color: white !important;
        }

    .btn-outline-success {
        color: #22c55e !important;
        border-color: #22c55e !important;
    }

        .btn-outline-success:hover {
            background: #22c55e !important;
            color: white !important;
        }

    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            transform: translateY(-1px);
        }

    /* Modal */
    .modal-content {
        background: var(--modal-bg) !important;
        border: 1px solid var(--modal-border) !important;
        border-radius: 16px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border-light) !important;
    }

    .modal-footer {
        border-top: 1px solid var(--border-light) !important;
    }

    .modal-title {
        color: var(--text-primary);
    }

    /* Form Elements */
    .form-control, .form-select {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .form-check-label {
        color: var(--text-secondary);
    }

    .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    /* Alerts */
    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: #ef4444 !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    /* Light mode overrides */
    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .btn-secondary {
        background: #f8f9fa !important;
        border-color: #dee2e6 !important;
        color: #1a1a2e !important;
    }

    [data-theme="light"] .modal-content {
        background: #ffffff !important;
    }

    [data-theme="light"] .form-check-label {
        color: #1a1a2e;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#studentsTable').DataTable({
                pageLength: 10,
                order: [[1, 'asc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ students",
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    }
                }
            });
            $('#staffTable').DataTable({
                pageLength: 10,
                order: [[1, 'asc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ staff members",
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    }
                }
            });
        });

        function editStudent(studentId) {
            $.get('@Url.Action("GetStudent", "Staff")', { id: studentId }, function (data) {
                $('#editStudentId').val(data.StudentID);
                $('#editFirstName').val(data.FirstName);
                $('#editLastName').val(data.LastName);
                $('#editEmail').val(data.Email);
                $('#editGender').val(data.Gender);
                $('#editFaculty').val(data.Faculty);
                $('#editYearOfStudy').val(data.YearOfStudy);
                $('#editIsActive').prop('checked', data.IsActive);
                new bootstrap.Modal(document.getElementById('editStudentModal')).show();
            });
        }

        function toggleStudentStatus(studentId, isActive) {
            if (confirm('Are you sure you want to ' + (isActive ? 'deactivate' : 'activate') + ' this student?')) {
                $.post('@Url.Action("ToggleStudentStatus", "Staff")', {
                    id: studentId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                }, function () { location.reload(); });
            }
        }

        function editStaff(staffId) {
            $.get('@Url.Action("GetStaff", "Staff")', { id: staffId }, function (data) {
                $('#editStaffId').val(data.StaffID);
                $('#editStaffFirstName').val(data.FirstName);
                $('#editStaffLastName').val(data.LastName);
                $('#editStaffEmail').val(data.Email);
                $('#editStaffRole').val(data.Role);
                $('#editStaffIsActive').prop('checked', data.IsActive);
                new bootstrap.Modal(document.getElementById('editStaffModal')).show();
            });
        }

        function toggleStaffStatus(staffId, isActive) {
            if (confirm('Are you sure you want to ' + (isActive ? 'deactivate' : 'activate') + ' this staff member?')) {
                $.post('@Url.Action("ToggleStaffStatus", "Staff")', {
                    id: staffId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                }, function () { location.reload(); });
            }
        }
    </script>
}