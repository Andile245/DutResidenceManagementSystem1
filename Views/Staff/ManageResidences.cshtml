@model List<DUTResManagementSystem.Models.Residence>

@{
    ViewBag.Title = "Manage Residences";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-building me-2" style="color:var(--primary)"></i>Manage Residences</h1>
        <div class="breadcrumb-text">Add, edit and manage residence buildings</div>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addResidenceModal">
        <i class="fas fa-plus me-2"></i>Add New Residence
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats — using live ViewBag values calculated in controller -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.15);color:var(--primary)">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count</div>
                <div class="stat-label">Total Residences</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <div class="stat-num">@ViewBag.TotalCapacity</div>
                <div class="stat-label">Total Capacity</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b">
                <i class="fas fa-user-check"></i>
            </div>
            <div>
                <div class="stat-num">@ViewBag.TotalOccupancy</div>
                <div class="stat-label">Current Occupancy</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#10b981">
                <i class="fas fa-door-open"></i>
            </div>
            <div>
                <div class="stat-num">@ViewBag.AvailableSpaces</div>
                <div class="stat-label">Available Spaces</div>
            </div>
        </div>
    </div>
</div>

<!-- Residences Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2" style="color:var(--primary)"></i>All Residences</span>
        <span class="badge" style="background:var(--primary-light);color:var(--primary)">@Model.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0" id="residencesTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Capacity</th>
                        <th>Occupancy</th>
                        <th>Available</th>
                        <th>Gender</th>
                        <th>Contact</th>
                        <th>Faculty</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        int available = r.Capacity - r.CurrentOccupancy;
                        int pct = r.Capacity > 0 ? (int)((double)r.CurrentOccupancy / r.Capacity * 100) : 0;
                        string ocClass = r.CurrentOccupancy >= r.Capacity ? "danger" : r.CurrentOccupancy > r.Capacity * 0.8 ? "warning" : "success";
                        string ocBg = r.CurrentOccupancy >= r.Capacity ? "rgba(239,68,68,0.15)" : r.CurrentOccupancy > r.Capacity * 0.8 ? "rgba(245,158,11,0.15)" : "rgba(34,197,94,0.15)";
                        string ocColor = r.CurrentOccupancy >= r.Capacity ? "#ef4444" : r.CurrentOccupancy > r.Capacity * 0.8 ? "#f59e0b" : "#22c55e";

                        string genderBg = r.GenderPolicy == "Mixed" ? "rgba(59,130,246,0.15)" : r.GenderPolicy == "Male" ? "rgba(59,130,246,0.15)" : "rgba(236,72,153,0.15)";
                        string genderColor = r.GenderPolicy == "Mixed" ? "var(--primary)" : r.GenderPolicy == "Male" ? "var(--primary)" : "#ec4899";

                        <tr>
                            <td style="font-weight:700;color:var(--text-primary)">@r.Name</td>
                            <td style="font-size:0.82rem;color:var(--text-muted);max-width:150px">@r.Address</td>
                            <td style="color:var(--text-secondary)">@r.Capacity</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:5px;min-width:50px;background:var(--progress-bg)">
                                        <div class="progress-bar" style="width:@pct%;background:@ocColor;border-radius:5px"></div>
                                    </div>
                                    <span class="badge" style="background:@ocBg;color:@ocColor;border:1px solid @ocColor;font-size:0.72rem">
                                        @r.CurrentOccupancy/@r.Capacity
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (available > 0)
                                {
                                    <span style="color:#22c55e;font-weight:600">@available free</span>
                                }
                                else
                                {
                                    <span style="color:#ef4444;font-weight:600">Full</span>
                                }
                            </td>
                            <td>
                                <span class="badge" style="background:@genderBg;color:@genderColor;border:1px solid @genderColor">
                                    @r.GenderPolicy
                                </span>
                            </td>
                            <td style="font-size:0.82rem;color:var(--text-muted)">@r.ContactNumber</td>
                            <td style="font-size:0.78rem;color:var(--text-muted);max-width:120px">
                                @(string.IsNullOrEmpty(r.Faculty) ? "—" : r.Faculty)
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @Html.ActionLink("Edit", "EditResidence", new { id = r.ResidenceID },
                                        new { @class = "btn btn-sm btn-outline-primary me-1" })
                                    @using (Html.BeginForm("DeleteResidence", "Staff",
                                        new { id = r.ResidenceID }, FormMethod.Post,
                                        new
                                        {
                                            @class = "d-inline",
                                            onsubmit = "return confirm('Delete " + r.Name + "? This cannot be undone.');"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Residence Modal -->
<div class="modal fade" id="addResidenceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2" style="color:var(--primary)"></i>Add New Residence
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("AddResidence", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Residence Name *</label>
                            <input type="text" class="form-control" name="Name" required placeholder="e.g., Liberty House">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Capacity *</label>
                            <input type="number" class="form-control" name="Capacity" required min="1" placeholder="Number of students">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address *</label>
                        <textarea class="form-control" name="Address" required rows="2" placeholder="Full physical address"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender Policy *</label>
                            <select class="form-select" name="GenderPolicy" required>
                                <option value="">Select Policy</option>
                                <option value="Mixed">Mixed</option>
                                <option value="Male">Male Only</option>
                                <option value="Female">Female Only</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact Number *</label>
                            <input type="tel" class="form-control" name="ContactNumber" required placeholder="+27 31 000 0000">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Faculty <span style="color:var(--text-muted);font-weight:400">(Optional — leave blank for all faculties)</span>
                        </label>
                        <select class="form-select" name="Faculty">
                            <option value="">All Faculties / No Restriction</option>
                            <option value="Accounting and Informatics">Accounting and Informatics</option>
                            <option value="Applied Sciences">Applied Sciences</option>
                            <option value="Arts and Design">Arts and Design</option>
                            <option value="Engineering and the Built Environment">Engineering and the Built Environment</option>
                            <option value="Health Sciences">Health Sciences</option>
                            <option value="Management Sciences">Management Sciences</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Add Residence
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Stat Cards */
    .stat-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--primary) !important;
        }

    .stat-num {
        font-family: 'Roboto', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Card */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Table */
    .table {
        color: var(--text-secondary) !important;
    }

        .table thead th {
            background: var(--bg-elevated) !important;
            color: var(--text-primary) !important;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-color: var(--border-light) !important;
            font-weight: 600;
        }

        .table tbody tr {
            border-color: var(--border-light) !important;
        }

            .table tbody tr:hover {
                background: var(--table-hover) !important;
            }

        .table td, .table th {
            border-color: var(--border-light) !important;
            color: var(--text-secondary);
        }

    /* Progress Bar */
    .progress {
        background: var(--progress-bg) !important;
    }

    /* Buttons */
    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
            transform: translateY(-1px);
        }

    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

    .btn-outline-danger {
        color: #ef4444 !important;
        border-color: #ef4444 !important;
    }

        .btn-outline-danger:hover {
            background: #ef4444 !important;
            color: white !important;
        }

    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

        .btn-secondary:hover {
            background: var(--hover-bg) !important;
            transform: translateY(-1px);
        }

    /* Modal */
    .modal-content {
        background: var(--modal-bg) !important;
        border: 1px solid var(--modal-border) !important;
        border-radius: 16px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border-light) !important;
    }

    .modal-footer {
        border-top: 1px solid var(--border-light) !important;
    }

    .modal-title {
        color: var(--text-primary);
    }

    /* Form Elements */
    .form-control, .form-select {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-family: 'Roboto', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .breadcrumb-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Alerts */
    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: #ef4444 !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

    /* Light mode overrides */
    [data-theme="light"] .stat-num {
        color: #1a1a2e;
    }

    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .btn-secondary {
        background: #f8f9fa !important;
        border-color: #dee2e6 !important;
        color: #1a1a2e !important;
    }

    [data-theme="light"] .modal-content {
        background: #ffffff !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#residencesTable').DataTable({
                pageLength: 15,
                order: [[0, 'asc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ residences",
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    }
                }
            });
            $('#addResidenceModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
            });
        });
    </script>
}