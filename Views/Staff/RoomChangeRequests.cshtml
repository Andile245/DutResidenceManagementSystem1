@model List<DUTResManagementSystem.Models.RoomChangeRequest>

@{
    ViewBag.Title = "Room Change Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1><i class="fas fa-exchange-alt me-2" style="color:var(--primary)"></i>Room Change Requests</h1>
        <div class="breadcrumb-text"><i class="fas fa-building me-1"></i><strong>@ViewBag.ResidenceName</strong></div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{<div class="alert alert-success alert-dismissible fade show mb-3"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
@if (TempData["ErrorMessage"] != null)
{<div class="alert alert-danger alert-dismissible fade show mb-3"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}

<!-- Stat Cards with proper light mode colors -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Pending")</div>
                <div class="stat-label">Pending Review</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Approved")</div>
                <div class="stat-label">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(239,68,68,0.15);color:#ef4444">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.Status == "Declined")</div>
                <div class="stat-label">Declined</div>
            </div>
        </div>
    </div>
</div>

<!-- Info Alert - Light mode friendly -->
<div class="alert alert-info mb-4">
    <i class="fas fa-info-circle me-2"></i>
    <strong>How approvals work:</strong> When you <strong>approve</strong> a request, the student is removed from their current room and appears in the unallocated list for reassignment. If you <strong>decline</strong>, the student stays in their current room.
</div>

@if (Model.Any())
{
    foreach (var request in Model)
    {
        string bc = request.Status == "Approved" ? "success" : request.Status == "Declined" ? "danger" : "warning";
        bool isPending = request.Status == "Pending";
        string studentName = request.Student != null ? request.Student.FirstName + " " + request.Student.LastName : "Unknown Student";
        string studentNumber = request.Student?.StudentNumber ?? "";
        string currentRoomInfo = request.CurrentRoom != null ? "Room " + request.CurrentRoom.RoomNumber + " (" + request.CurrentRoom.RoomType + ")" : "Room info unavailable";
        string borderHex = bc == "success" ? "rgba(34,197,94,0.25)" : bc == "danger" ? "rgba(239,68,68,0.25)" : "rgba(245,158,11,0.25)";
        string statusColor = bc == "success" ? "#22c55e" : bc == "danger" ? "#ef4444" : "#f59e0b";
        string statusBg = bc == "success" ? "rgba(34,197,94,0.15)" : bc == "danger" ? "rgba(239,68,68,0.15)" : "rgba(245,158,11,0.15)";

        <div class="card mb-4" style="border-color:@borderHex!important">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-exchange-alt me-2" style="color:@statusColor"></i>
                    <strong style="color:var(--text-primary)">Request #@request.RequestID — @studentName</strong>
                    @if (!string.IsNullOrEmpty(studentNumber))
                    {<small style="color:var(--text-muted)"> (@studentNumber)</small>}
                </span>
                <span class="badge" style="background:@statusBg;color:@statusColor;border:1px solid @statusColor">@request.Status</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Current Room</div>
                        <div style="font-weight:700;color:var(--text-primary)">@currentRoomInfo</div>
                    </div>
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Date Submitted</div>
                        <div style="color:var(--text-secondary)">@request.DateRequested.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
                <div class="mb-3">
                    <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Reason from Student</div>
                    <div style="background:var(--bg-elevated);border-radius:8px;padding:0.75rem;color:var(--text-secondary);border:1px solid var(--border-light)">@request.Reason</div>
                </div>
                @if (!string.IsNullOrEmpty(request.DocumentPath))
                {
                    <div class="mb-3">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Supporting Document</div>
                        <a href="@request.DocumentPath" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-file me-1"></i>View Document</a>
                    </div>
                }
                @if (!isPending && !string.IsNullOrEmpty(request.AdminFeedback))
                {
                    <div class="mb-3">
                        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:0.25rem">Your Feedback</div>
                        <div class="alert" style="background:@statusBg;border:1px solid @statusColor;color:var(--text-primary);padding:0.75rem;border-radius:8px">@request.AdminFeedback</div>
                    </div>
                }
                @if (isPending)
                {
                    <hr style="border-color:var(--border-light)" />
                    <h6 style="color:var(--text-primary);margin-bottom:1rem"><i class="fas fa-gavel me-2" style="color:var(--primary)"></i>Review This Request</h6>
                    using (Html.BeginForm("ReviewRoomChangeRequest", "Staff", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@request.RequestID" />
                        <div class="mb-3">
                            <label class="form-label">Feedback to Student <span style="color:var(--text-muted);font-weight:400">(Recommended)</span></label>
                            <textarea name="adminFeedback" class="form-control" rows="3" placeholder="Explain your decision..."></textarea>
                            <div class="form-text">Approve: student removed from @currentRoomInfo and shown in unallocated list. Decline: student stays in their room.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" name="decision" value="Approved" class="btn btn-success" onclick="return confirm('Approve this request? Student will be removed from @currentRoomInfo.')"><i class="fas fa-check me-2"></i>Approve</button>
                            <button type="submit" name="decision" value="Declined" class="btn btn-danger" onclick="return confirm('Decline this request? Student remains in @currentRoomInfo.')"><i class="fas fa-times me-2"></i>Decline</button>
                        </div>
                    }
                }
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5" style="color:var(--text-muted)">
            <i class="fas fa-exchange-alt fa-4x mb-3"></i>
            <h5>No room change requests</h5>
            <p>No requests for your residence yet.</p>
        </div>
    </div>
}

<style>
    /* Stat Cards */
    .stat-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--primary) !important;
        }

    .stat-num {
        font-family: 'Roboto', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Card Styles */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    /* Alert Styles - Light mode friendly */
    .alert-info {
        background: rgba(59,130,246,0.1) !important;
        border: 1px solid rgba(59,130,246,0.2) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
    }

    [data-theme="light"] .alert-info {
        background: #d1ecf1 !important;
        border-color: #bee5eb !important;
        color: #0c5460 !important;
    }

    .alert-success {
        background: rgba(34,197,94,0.1) !important;
        border: 1px solid rgba(34,197,94,0.2) !important;
        color: var(--text-primary) !important;
    }

    [data-theme="light"] .alert-success {
        background: #d4edda !important;
        border-color: #c3e6cb !important;
        color: #155724 !important;
    }

    .alert-danger {
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.2) !important;
        color: var(--text-primary) !important;
    }

    [data-theme="light"] .alert-danger {
        background: #f8d7da !important;
        border-color: #f5c6cb !important;
        color: #721c24 !important;
    }

    /* Form Elements */
    .form-control {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
    }

        .form-control:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
        }

        .form-control::placeholder {
            color: var(--input-placeholder) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
    }

    .form-text {
        color: var(--text-muted-light) !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-success {
        background: #22c55e !important;
        border-color: #22c55e !important;
        color: white !important;
    }

        .btn-success:hover {
            background: #16a34a !important;
            border-color: #16a34a !important;
        }

    .btn-danger {
        background: #ef4444 !important;
        border-color: #ef4444 !important;
        color: white !important;
    }

        .btn-danger:hover {
            background: #dc2626 !important;
            border-color: #dc2626 !important;
        }

    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

    /* Light mode specific overrides */
    [data-theme="light"] .stat-num {
        color: #1a1a2e;
    }

    [data-theme="light"] .card-header {
        background: #f8f9fa !important;
    }

        [data-theme="light"] .card-header strong {
            color: #1a1a2e !important;
        }

        [data-theme="light"] .card-header small {
            color: #6c757d !important;
        }

    [data-theme="light"] .form-label {
        color: #1a1a2e;
    }

    [data-theme="light"] .badge {
        color: inherit;
    }

    /* Ensure text is always visible */
    .text-muted {
        color: var(--text-muted) !important;
    }
</style>