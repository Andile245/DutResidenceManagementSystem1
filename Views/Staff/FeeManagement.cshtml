@model DUTResManagementSystem.ViewModels.FeeManagementViewModel

@{
    ViewBag.Title = "Fee Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1><i class="fas fa-file-invoice-dollar me-2" style="color:var(--primary)"></i>Fee Management</h1>
        <div class="breadcrumb-text">Set up residence fees and track student payments</div>
    </div>
    <div class="d-flex gap-2">
        @using (Html.BeginForm("SendPaymentReminders", "Staff", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm"
                    onclick="return confirm('Send payment reminder emails to all students with outstanding balances?')">
                <i class="fas fa-envelope me-1"></i>Send Reminders
            </button>
        }
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createFeeModal">
            <i class="fas fa-plus me-1"></i>Set Up Fee
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon red"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="stat-num" style="font-size:1.4rem">R @Model.TotalOutstanding.ToString("N2")</div>
                <div class="stat-label">Total Outstanding</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="stat-num" style="font-size:1.4rem">R @Model.TotalCollected.ToString("N2")</div>
                <div class="stat-label">Total Collected</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-graduation-cap"></i></div>
            <div>
                <div class="stat-num">@Model.NSFASStudents</div>
                <div class="stat-label">NSFAS Students</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon yellow"><i class="fas fa-wallet"></i></div>
            <div>
                <div class="stat-num">@Model.SelfPayingStudents</div>
                <div class="stat-label">Self-Paying Students</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Fee Configurations -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-cog me-2" style="color:var(--primary)"></i>Fee Configurations</span>
                <span class="badge bg-primary">@Model.Fees.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Fees.Any())
                {
                    foreach (var fee in Model.Fees)
                    {
                        <div class="p-3" style="border-bottom:1px solid rgba(255,255,255,0.05)">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div style="font-weight:700;color:#E8E8F0">@fee.Residence.Name</div>
                                    <div style="font-size:0.78rem;color:#6B6B80">@fee.AcademicYear — @fee.PaymentStructure</div>
                                </div>
                                <div class="text-end">
                                    <div style="font-weight:700;color:#22c55e;font-size:1rem">
                                        R @fee.AnnualAmount.ToString("N2")
                                    </div>
                                    <div style="font-size:0.72rem;color:#6B6B80">
                                        @(fee.PaymentStructure == "Monthly"
                                            ? $"{fee.NumberOfInstallments} × R{(fee.AnnualAmount / fee.NumberOfInstallments):N2}/month"
                                            : "Annual lump sum")
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <span class="badge @(fee.IsActive ? "bg-success" : "bg-secondary")">
                                    @(fee.IsActive ? "Active" : "Inactive")
                                </span>
                                @if (fee.IsActive)
                                {
                                    using (Html.BeginForm("GenerateInvoices", "Staff", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="feeId" value="@fee.FeeID" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary"
                                                style="font-size:0.72rem;padding:0.2rem 0.6rem"
                                                onclick="return confirm('Generate invoices for all students in @fee.Residence.Name?')">
                                            <i class="fas fa-file-invoice me-1"></i>Generate Invoices
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5" style="color:#6B6B80">
                        <i class="fas fa-file-invoice-dollar fa-3x mb-3"></i>
                        <p>No fee configurations yet.<br>Click <strong>Set Up Fee</strong> to start.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Outstanding Invoices -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-exclamation-triangle me-2" style="color:#eab308"></i>Outstanding Invoices</span>
                <span class="badge bg-warning">@Model.OutstandingInvoices.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="px-3 pt-3">
                    <div style="font-size:0.78rem;color:#6B6B80">
                        <i class="fas fa-info-circle me-1" style="color:#eab308"></i>
                        Showing invoices up to and including
                        <strong style="color:#E8E8F0">@(((DateTime)ViewBag.CurrentMonthEnd).ToString("MMMM yyyy"))</strong>
                        only. Future installments are not counted as outstanding until their month arrives.
                    </div>
                </div>
                @if (Model.OutstandingInvoices.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0" id="outstandingTable">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Invoice #</th>
                                    <th>Amount</th>
                                    <th>Balance</th>
                                    <th>Due</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model.OutstandingInvoices)
                                {
                                    string sc = inv.Status == "Overdue" ? "#f87171"
                                              : inv.Status == "Partial" ? "#eab308"
                                              : "#A0A0B5";
                                    string sb = inv.Status == "Overdue" ? "danger"
                                              : inv.Status == "Partial" ? "warning"
                                              : "secondary";
                                    <tr>
                                        <td>
                                            <div style="font-weight:600;color:#E8E8F0;font-size:0.85rem">
                                                @inv.Student.FirstName @inv.Student.LastName
                                            </div>
                                            <div style="font-size:0.72rem;color:#6B6B80">
                                                @inv.Student.StudentNumber
                                            </div>
                                        </td>
                                        <td style="font-size:0.78rem;color:#A0A0B5">@inv.InvoiceNumber</td>
                                        <td style="font-size:0.85rem">R @inv.Amount.ToString("N2")</td>
                                        <td style="color:@sc;font-weight:600;font-size:0.85rem">
                                            R @inv.Balance.ToString("N2")
                                        </td>
                                        <td style="font-size:0.78rem;color:@(inv.DueDate < DateTime.Now ? "#f87171" : "#A0A0B5")">
                                            @inv.DueDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td><span class="badge bg-@sb">@inv.Status</span></td>
                                        <td>
                                            <a href="@Url.Action("RecordPayment", "Staff", new { invoiceId = inv.InvoiceID })"
                                               class="btn btn-sm btn-outline-primary" style="font-size:0.72rem">
                                                <i class="fas fa-plus me-1"></i>Record
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5" style="color:#6B6B80">
                        <i class="fas fa-check-circle fa-3x mb-3" style="color:#22c55e"></i>
                        <p>No outstanding invoices. All students are up to date.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create Fee Modal -->
<div class="modal fade" id="createFeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus me-2" style="color:var(--primary)"></i>Set Up Residence Fee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("CreateFee", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Residence *</label>
                        <select class="form-select" name="residenceId" required>
                            <option value="">-- Select Residence --</option>
                            @foreach (var r in Model.Residences)
                            {
                                <option value="@r.ResidenceID">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Annual Amount (R) *</label>
                        <input type="number" class="form-control" name="annualAmount"
                               placeholder="e.g. 45000" min="1" step="0.01" required />
                        <div class="form-text">Enter the total annual residence fee set by the landlord.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Structure *</label>
                        <select class="form-select" name="paymentStructure" id="paymentStructure"
                                onchange="toggleInstallments(this.value)" required>
                            <option value="">-- Select --</option>
                            <option value="Annual">Annual (one lump sum)</option>
                            <option value="Monthly">Monthly (installments)</option>
                        </select>
                    </div>
                    <div class="mb-3" id="installmentsDiv" style="display:none">
                        <label class="form-label">Number of Monthly Installments *</label>
                        <select class="form-select" name="numberOfInstallments">
                            <option value="10">10 months (Feb — Nov)</option>
                            <option value="12">12 months (Jan — Dec)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Academic Year *</label>
                        <input type="text" class="form-control" name="academicYear"
                               value="@DateTime.Now.Year" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea class="form-control" name="description" rows="2"
                                  placeholder="e.g. Includes WiFi and water"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Create Fee</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#outstandingTable').DataTable({ pageLength: 10, order: [[4, 'asc']] });
        });
        function toggleInstallments(val) {
            document.getElementById('installmentsDiv').style.display =
                val === 'Monthly' ? 'block' : 'none';
        }
    </script>
}
