@{
    ViewBag.Title = "Student QR Code";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var checkIn = ViewBag.CheckIn as DUTResManagementSystem.Models.ResidenceCheckIn;
    string checkInQRImage = ViewBag.CheckInQRImage;
    string checkOutQRImage = ViewBag.CheckOutQRImage;
    string checkInUrl = ViewBag.CheckInUrl;
    string checkOutUrl = ViewBag.CheckOutUrl;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1><i class="fas fa-qrcode me-2" style="color:var(--primary)"></i>Student QR Code</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CheckInManagement", "Staff")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
        <button class="btn btn-outline-primary btn-sm" onclick="window.print()">
            <i class="fas fa-print me-1"></i>Print QR Codes
        </button>
    </div>
</div>

<!-- Student Info Card -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-auto">
                <div style="width:56px;height:56px;border-radius:14px;background:var(--primary-light);
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.5rem;font-weight:700;color:var(--primary)">
                    @checkIn.Student.FirstName.Substring(0, 1).ToUpper()
                </div>
            </div>
            <div class="col">
                <div style="font-size:1.1rem;font-weight:700;color:var(--text-primary)">
                    @checkIn.Student.FirstName @checkIn.Student.LastName
                </div>
                <div style="font-size:0.85rem;color:var(--text-secondary)">
                    @checkIn.Student.StudentNumber &nbsp;·&nbsp;
                    @checkIn.Student.Faculty &nbsp;·&nbsp;
                    Year @checkIn.Student.YearOfStudy
                </div>
            </div>
            <div class="col-auto">
                @if (checkIn != null && checkIn.HasCheckedIn)
                {
                    <span class="badge" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3);font-size:0.85rem;padding:0.5rem 1rem">
                        <i class="fas fa-check me-1"></i>Checked In
                        @checkIn.CheckInTime
                    </span>
                }
                else
                {
                    <span class="badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);font-size:0.85rem;padding:0.5rem 1rem">
                        <i class="fas fa-clock me-1"></i>Not Yet Checked In
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<!-- QR Codes Side by Side -->
<div class="row g-4 mb-4" id="printArea">
    <!-- Check-IN QR -->
    <div class="col-md-6">
        <div class="card text-center" style="border-color:rgba(34,197,94,0.3)!important">
            <div class="card-header" style="background:rgba(34,197,94,0.08)!important;border-color:rgba(34,197,94,0.3)!important">
                <i class="fas fa-sign-in-alt me-2" style="color:#22c55e"></i>
                <span style="font-weight:700;color:#22c55e">CHECK-IN QR CODE</span>
            </div>
            <div class="card-body py-4">
                <div style="background:var(--bg-elevated);display:inline-block;padding:12px;border-radius:12px;margin-bottom:1rem;border:1px solid var(--border-color)">
                    <img src="@checkInQRImage"
                         alt="Check-In QR Code"
                         style="width:220px;height:220px;display:block" />
                </div>
                <div style="font-size:0.82rem;color:var(--text-secondary);margin-bottom:0.5rem">
                    Student scans this to <strong style="color:#22c55e">check IN</strong>
                </div>
                <div style="font-size:0.72rem;color:var(--text-muted);word-break:break-all;
                            background:var(--bg-elevated);padding:0.5rem;border-radius:6px;
                            font-family:monospace;border:1px solid var(--border-light)">
                    @checkInUrl
                </div>
            </div>
            <div class="card-body pt-0">
                <a href="@checkInQRImage" download="CheckIn_@(checkIn.Student.StudentNumber).png"
                   class="btn btn-sm btn-outline-success me-2">
                    <i class="fas fa-download me-1"></i>Download
                </a>
                <button class="btn btn-sm btn-success" onclick="copyToClipboard('@checkInUrl')">
                    <i class="fas fa-copy me-1"></i>Copy Link
                </button>
            </div>
        </div>
    </div>

    <!-- Check-OUT QR -->
    <div class="col-md-6">
        <div class="card text-center" style="border-color:rgba(59,130,246,0.3)!important">
            <div class="card-header" style="background:rgba(59,130,246,0.08)!important;border-color:rgba(59,130,246,0.3)!important">
                <i class="fas fa-sign-out-alt me-2" style="color:var(--primary)"></i>
                <span style="font-weight:700;color:var(--primary)">CHECK-OUT QR CODE</span>
            </div>
            <div class="card-body py-4">
                <div style="background:var(--bg-elevated);display:inline-block;padding:12px;border-radius:12px;margin-bottom:1rem;border:1px solid var(--border-color)">
                    <img src="@checkOutQRImage"
                         alt="Check-Out QR Code"
                         style="width:220px;height:220px;display:block" />
                </div>
                <div style="font-size:0.82rem;color:var(--text-secondary);margin-bottom:0.5rem">
                    Student scans this to <strong style="color:var(--primary)">check OUT</strong>
                </div>
                <div style="font-size:0.72rem;color:var(--text-muted);word-break:break-all;
                            background:var(--bg-elevated);padding:0.5rem;border-radius:6px;
                            font-family:monospace;border:1px solid var(--border-light)">
                    @checkOutUrl
                </div>
            </div>
            <div class="card-body pt-0">
                <a href="@checkOutQRImage" download="CheckOut_@(checkIn.Student.StudentNumber).png"
                   class="btn btn-sm btn-outline-primary me-2">
                    <i class="fas fa-download me-1"></i>Download
                </a>
                <button class="btn btn-sm btn-primary" onclick="copyToClipboard('@checkOutUrl')">
                    <i class="fas fa-copy me-1"></i>Copy Link
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Instructions Card -->
<div class="card">
    <div class="card-header">
        <i class="fas fa-info-circle me-2" style="color:var(--primary)"></i>Instructions for Student
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <div style="font-weight:700;color:#22c55e;margin-bottom:0.75rem">
                    <i class="fas fa-sign-in-alt me-2"></i>How to Check In
                </div>
                <ol style="color:var(--text-secondary);font-size:0.88rem;line-height:1.8;padding-left:1.25rem">
                    <li>Log in to your student account on your phone</li>
                    <li>Scan the <strong style="color:#22c55e">green Check-In QR code</strong></li>
                    <li>Your check-in will be recorded automatically</li>
                    <li>You can now be allocated a room by your building manager</li>
                </ol>
            </div>
            <div class="col-md-6">
                <div style="font-weight:700;color:var(--primary);margin-bottom:0.75rem">
                    <i class="fas fa-sign-out-alt me-2"></i>How to Check Out
                </div>
                <ol style="color:var(--text-secondary);font-size:0.88rem;line-height:1.8;padding-left:1.25rem">
                    <li>Log in to your student account on your phone</li>
                    <li>Scan the <strong style="color:var(--primary)">blue Check-Out QR code</strong></li>
                    <li>Your check-out time will be logged</li>
                </ol>
            </div>
        </div>
        <div class="mt-3 pt-3" style="border-top:1px solid var(--border-light)">
            <i class="fas fa-shield-alt me-2" style="color:#f59e0b"></i>
            <span style="font-size:0.82rem;color:var(--text-secondary)">
                <strong style="color:#f59e0b">Important:</strong>
                This QR code is personal and unique to <strong style="color:var(--text-primary)">@checkIn.Student.FirstName @checkIn.Student.LastName</strong>.
                It cannot be used by any other student.
                If shared, it will simply not work for another person.
            </span>
        </div>
    </div>
</div>

<style>
    /* Card Styles */
    .card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px !important;
    }

    .card-header {
        background: var(--card-header-bg) !important;
        border-bottom: 1px solid var(--border-light) !important;
        border-radius: 12px 12px 0 0 !important;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        background: var(--bg-card) !important;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-header h1 {
        font-family: 'Roboto', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    /* Buttons */
    .btn-secondary {
        background: var(--bg-elevated) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

    .btn-secondary:hover {
        background: var(--hover-bg) !important;
        transform: translateY(-1px);
    }

    .btn-outline-primary {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }

    .btn-outline-primary:hover {
        background: var(--primary) !important;
        color: white !important;
    }

    .btn-outline-success {
        color: #22c55e !important;
        border-color: #22c55e !important;
    }

    .btn-outline-success:hover {
        background: #22c55e !important;
        color: white !important;
    }

    .btn-success {
        background: #22c55e !important;
        border-color: #22c55e !important;
    }

    .btn-success:hover {
        background: #16a34a !important;
        border-color: #16a34a !important;
    }

    .btn-primary {
        background: var(--primary) !important;
        border-color: var(--primary) !important;
    }

    .btn-primary:hover {
        background: var(--primary-dark) !important;
        border-color: var(--primary-dark) !important;
    }

    /* Badge */
    .badge {
        font-weight: 500;
    }

    /* Light mode overrides */
    [data-theme="light"] .card-header {
        color: #1a1a2e;
    }

    [data-theme="light"] .text-muted {
        color: #6c757d !important;
    }

    /* Print Styles */
    @@media print {
        .topbar, .sidebar, .main-footer, .page-header .d-flex,
        .card:not(#printArea.card) {
            display: none !important;
        }

        body {
            background: white !important;
            color: black !important;
        }

        .card {
            border: 1px solid #ccc !important;
            background: white !important;
            box-shadow: none !important;
        }

        .card-header {
            background: #f8f9fa !important;
            color: #1a1a2e !important;
        }

        #printArea {
            display: flex !important;
        }

        .btn, .btn-sm {
            display: none !important;
        }
    }
</style>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function () {
                alert('Link copied to clipboard! You can now share it with the student via WhatsApp or email.');
            }).catch(function () {
                prompt('Copy this link and share with the student:', text);
            });
        }
    </script>
}