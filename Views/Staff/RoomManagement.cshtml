@model List<DUTResManagementSystem.ViewModels.RoomWithOccupants>

@{
    ViewBag.Title = "Room Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.StaffRole == "Admin";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1>
            <i class="fas fa-door-open me-2" style="color:var(--primary)"></i>Room Management
            @if (ViewBag.Residence != null)
            {<small style="font-size:0.9rem;color:var(--text-muted)"> — @ViewBag.Residence.Name</small>}
        </h1>
        <div class="breadcrumb-text">Add, edit and delete rooms</div>
    </div>
    <button class="btn btn-primary" onclick="openAddRoomModal()">
        <i class="fas fa-plus me-2"></i>Add Room
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.12);color:var(--primary)">
                <i class="fas fa-door-open"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count</div>
                <div class="stat-label">Total Rooms</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.12);color:#22c55e">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => !r.IsFull)</div>
                <div class="stat-label">Available</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(239,68,68,0.12);color:#ef4444">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Count(r => r.IsFull)</div>
                <div class="stat-label">Full</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.12);color:var(--primary)">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <div class="stat-num">@Model.Sum(r => r.CurrentOccupants)</div>
                <div class="stat-label">Students in Rooms</div>
            </div>
        </div>
    </div>
</div>

<!-- Rooms Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2" style="color:var(--primary)"></i>All Rooms</span>
        <span class="badge" style="background:var(--primary-light);color:var(--primary)">@Model.Count</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0" id="roomsTable">
                    <thead>
                        <tr>
                            @if (isAdmin)
                            {
                                <th>Residence</th>
                            }
                            <th>Room Number</th>
                            <th>Type</th>
                            <th>Floor</th>
                            <th>Gender</th>
                            <th>Capacity</th>
                            <th>Occupancy</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rwo in Model)
                        {
                            int pct = rwo.Room.Capacity > 0 ? (int)((double)rwo.CurrentOccupants / rwo.Room.Capacity * 100) : 0;
                            string floorText = rwo.Room.Floor.HasValue ? "Floor " + rwo.Room.Floor : "—";
                            string genderColour = rwo.Room.Gender == "Male" ? "primary" : rwo.Room.Gender == "Female" ? "danger" : "success";
                            string statusColour = rwo.Room.Status == "Available" ? "success" : "danger";
                            <tr>
                                @if (isAdmin)
                                {
                                    <td style="color:var(--text-muted);font-size:0.85rem">@rwo.Room.Residence?.Name</td>
                                }
                                <td style="font-weight:700;color:var(--text-primary)">@rwo.Room.RoomNumber</td>
                                <td><span class="badge" style="background:var(--bg-elevated);color:var(--text-secondary)">@rwo.Room.RoomType</span></td>
                                <td style="color:var(--text-muted)">@floorText</td>
                                <td>
                                    <span class="badge" style="background:rgba(59,130,246,0.15);color:var(--primary)">
                                        @rwo.Room.Gender
                                    </span>
                                </td>
                                <td>@rwo.Room.Capacity</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px;min-width:60px;background:var(--border-light)">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width:@pct%;background:@(pct >= 80 ? "#f59e0b" : pct >= 100 ? "#ef4444" : "#22c55e");border-radius:10px">
                                            </div>
                                        </div>
                                        <small style="color:var(--text-muted);font-size:0.78rem">@rwo.CurrentOccupants/@rwo.Room.Capacity</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background:@(rwo.Room.Status == "Available" ? "rgba(34,197,94,0.15)" : "rgba(239,68,68,0.15)");color:@(rwo.Room.Status == "Available" ? "#22c55e" : "#ef4444")">
                                        @rwo.Room.Status
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:none;margin-right:0.25rem" onclick="openEditRoomModal(@rwo.Room.RoomID)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    @using (Html.BeginForm("DeleteRoom", "Staff", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roomId" value="@rwo.Room.RoomID" />
                                        <button type="submit" class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#ef4444;border:none" onclick="return confirm('Delete Room @rwo.Room.RoomNumber?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5" style="color:var(--text-muted)">
                <i class="fas fa-door-open fa-3x mb-3"></i>
                <h5>No rooms added yet</h5>
                <p>Click <strong>Add Room</strong> above to get started.</p>
            </div>
        }
    </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus me-2" style="color:var(--primary)"></i>Add New Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("AddRoom", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                if (!isAdmin && ViewBag.Residence != null)
                { <input type="hidden" name="residenceId" value="@ViewBag.Residence.ResidenceID" /> }
                <div class="modal-body">
                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Residence *</label>
                            @Html.DropDownList("residenceId", ViewBag.Residences as SelectList, "-- Select Residence --", new { @class = "form-select", required = "required" })
                        </div>
                    }
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Room Number *</label>
                            <input type="text" name="roomNumber" class="form-control" placeholder="e.g. 101" required maxlength="20" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Floor</label>
                            <input type="number" name="floor" class="form-control" placeholder="e.g. 1" min="0" max="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Room Type *</label>
                            <select name="roomType" id="addRoomType" class="form-select" required>
                                <option value="">-- Select Type --</option>
                                <option value="Single">Single (1 bed)</option>
                                <option value="Double">Double (2 beds)</option>
                                <option value="Triple">Triple (3 beds)</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Capacity *</label>
                            <input type="number" name="capacity" id="addCapacity" class="form-control" min="1" max="10" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Gender Policy *</label>
                        <select name="gender" class="form-select" required>
                            <option value="">-- Select --</option>
                            <option value="Male">Male Only</option>
                            <option value="Female">Female Only</option>
                            <option value="Mixed">Mixed</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Room</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal fade" id="editRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit me-2" style="color:#f59e0b"></i>Edit Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("EditRoom", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRoomId" name="roomId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Room Number *</label>
                            <input type="text" id="editRoomNumber" name="roomNumber" class="form-control" required maxlength="20" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Floor</label>
                            <input type="number" id="editFloor" name="floor" class="form-control" min="0" max="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Room Type *</label>
                            <select id="editRoomType" name="roomType" class="form-select" required>
                                <option value="Single">Single</option>
                                <option value="Double">Double</option>
                                <option value="Triple">Triple</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Capacity *</label>
                            <input type="number" id="editCapacity" name="capacity" class="form-control" min="1" max="10" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Gender Policy *</label>
                        <select id="editGender" name="gender" class="form-select" required>
                            <option value="Male">Male Only</option>
                            <option value="Female">Female Only</option>
                            <option value="Mixed">Mixed</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Stat Cards */
    .stat-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--primary) !important;
        }

    .stat-num {
        font-family: 'Roboto', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* Table Styles */
    .table {
        color: var(--text-secondary) !important;
    }

        .table thead th {
            background: var(--bg-elevated) !important;
            color: var(--text-primary) !important;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-color: var(--border-light) !important;
            font-weight: 600;
        }

        .table tbody tr {
            border-color: var(--border-light) !important;
        }

            .table tbody tr:hover {
                background: var(--table-hover) !important;
            }

        .table td, .table th {
            border-color: var(--border-light) !important;
            color: var(--text-secondary);
        }

    /* Progress Bar */
    .progress {
        background: var(--progress-bg) !important;
    }

    /* Modal Styles */
    .modal-content {
        background: var(--modal-bg) !important;
        border: 1px solid var(--modal-border) !important;
        border-radius: 16px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border-light) !important;
    }

    .modal-footer {
        border-top: 1px solid var(--border-light) !important;
    }

    .modal-title {
        color: var(--text-primary);
    }

    /* Form Elements */
    .form-control, .form-select {
        background: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: 8px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
        }

    .form-label {
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* Light mode overrides */
    [data-theme="light"] .stat-num {
        color: #1a1a2e;
    }

    [data-theme="light"] .table td,
    [data-theme="light"] .table th {
        color: #2d3436 !important;
    }

    [data-theme="light"] .btn-close {
        filter: invert(0);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#roomsTable').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ rooms",
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    }
                }
            });
        });

        function openAddRoomModal() {
            new bootstrap.Modal(document.getElementById('addRoomModal')).show();
        }

        document.getElementById('addRoomType').addEventListener('change', function () {
            var cap = document.getElementById('addCapacity');
            if (this.value === 'Single') cap.value = 1;
            else if (this.value === 'Double') cap.value = 2;
            else if (this.value === 'Triple') cap.value = 3;
            else cap.value = '';
        });

        function openEditRoomModal(roomId) {
            $.get('@Url.Action("GetRoom", "Staff")', { id: roomId }, function (data) {
                if (!data) { alert('Room not found.'); return; }
                document.getElementById('editRoomId').value = data.RoomID;
                document.getElementById('editRoomNumber').value = data.RoomNumber;
                document.getElementById('editRoomType').value = data.RoomType;
                document.getElementById('editCapacity').value = data.Capacity;
                document.getElementById('editGender').value = data.Gender;
                document.getElementById('editFloor').value = data.Floor ?? '';
                new bootstrap.Modal(document.getElementById('editRoomModal')).show();
            });
        }
    </script>
}