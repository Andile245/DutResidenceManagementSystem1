@model DUTResManagementSystem.Models.ElectionNomination
@{ ViewBag.Title = "My House Committee application"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4">
    <a href="@Url.Action("Details", new { id = Model.ResidenceElectionID })" class="text-muted">Back to election</a>
    <h2 class="mt-3">My House Committee application</h2>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    <div class="card mb-3"><div class="card-body">
        <p class="mb-1"><strong>Position:</strong> @Model.Position.Name</p>
        <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
        <p class="mb-1"><strong>Eligibility:</strong> @Model.EligibilityRecommendation</p>
        <p class="mb-0"><strong>Eligibility reason:</strong> @Model.EligibilityReason</p>
        @if (!String.IsNullOrWhiteSpace(Model.ReviewNote)) { <div class="alert alert-warning mt-3 mb-0"><strong>Reviewer note:</strong> @Model.ReviewNote</div> }
    </div></div>
    @if (Model.Status == "Pending Candidate Response")
    {
        <div class="card"><div class="card-body"><h5>Provide the requested information</h5>
        @using (Html.BeginForm("ReviseApplication", "Election", new { id = Model.ResidenceElectionID }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3"><label>Your manifesto and goals</label><textarea class="form-control" name="Manifesto" rows="5" maxlength="1500">@Model.Manifesto</textarea></div>
            <div class="mb-3"><label>Why should you be selected?</label><textarea class="form-control" name="Motivation" rows="4" maxlength="1000">@Model.Motivation</textarea></div>
            <input type="hidden" name="ElectionPositionID" value="@Model.ElectionPositionID" />
            <button class="btn btn-danger">Return application for review</button>
        }
        </div></div>
    }
    @if (Model.Status != "Withdrawn" && Model.Status != "Approved" && Model.Status != "Rejected" && Model.Status != "Rejected Automatically")
    {
        using (Html.BeginForm("WithdrawApplication", "Election", new { id = Model.ResidenceElectionID }, FormMethod.Post, new { @class = "mt-3" }))
        {
            @Html.AntiForgeryToken()
            <input class="form-control mb-2" name="reason" maxlength="500" placeholder="Withdrawal reason (optional)" />
            <button class="btn btn-outline-danger" type="submit">Withdraw candidacy</button>
        }
    }
</div>
