@model DUTResManagementSystem.ViewModels.ElectionDashboardViewModel
@{ ViewBag.Title="Review Election Accountability"; Layout="~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start"><div><h2>Review Election Accountability</h2><p class="text-muted">@Model.Election.Title - @Model.Election.Residence.Name - Official results published</p></div><a class="btn btn-outline-secondary" href="@Url.Action("AccountabilityReport", new { id = Model.Election.ResidenceElectionID })">Printable accountability report</a></div>
    <div class="row g-3"><div class="col-md-3"><div class="card"><div class="card-body"><small>Eligible voters</small><h2>@Model.EligibleVoters</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Voters participated</small><h2>@Model.BallotsCast</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Turnout</small><h2>@Model.Turnout%</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Approved applicants</small><h2>@Model.ApprovedCandidates / @Model.Nominations</h2></div></div></div></div>
    <h4 class="mt-4">Notification history</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Sent</th><th>Title</th><th>Message</th></tr></thead><tbody>@foreach(var item in Model.Notifications){<tr><td>@item.DateCreated.ToString("dd MMM yyyy HH:mm")</td><td>@item.Title</td><td>@item.Message</td></tr>}@if(!Model.Notifications.Any()){<tr><td colspan="3" class="text-muted">No election notifications were recorded.</td></tr>}</tbody></table></div>
    <h4 class="mt-4">Election audit trail</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Time</th><th>Event</th><th>Detail</th><th>Actor</th></tr></thead><tbody>@foreach(var item in Model.AuditLogs){<tr><td>@item.OccurredAt.ToString("dd MMM yyyy HH:mm")</td><td>@item.EventType</td><td>@item.Detail</td><td>@item.ActorType @(item.ActorID.HasValue ? "#" + item.ActorID : "")</td></tr>}@if(!Model.AuditLogs.Any()){<tr><td colspan="4" class="text-muted">No audit entries were recorded.</td></tr>}</tbody></table></div>
</div>
