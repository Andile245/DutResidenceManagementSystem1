@model DUTResManagementSystem.ViewModels.ElectionDashboardViewModel
@{ ViewBag.Title="Election analytics"; Layout="~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4"><h2>Election analytics</h2><p class="text-muted">@Model.Election.Title - @Model.Election.Residence.Name - @Model.Election.Status</p><div class="row g-3"><div class="col-md-3"><div class="card"><div class="card-body"><small>Eligible voters</small><h2>@Model.EligibleVoters</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Voters participated</small><h2>@Model.BallotsCast</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Turnout</small><h2>@Model.Turnout%</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>Approved applicants</small><h2>@Model.ApprovedCandidates / @Model.Nominations</h2></div></div></div></div><div class="alert alert-info mt-4">@if(Model.Election.Status == "Voting Open"){<text>Interim candidate rankings are intentionally hidden until voting closes.</text>}else{<text>Results are calculated automatically after ballot closure; ties are routed for administrative review.</text>}</div></div>
