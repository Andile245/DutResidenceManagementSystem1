@model DUTResManagementSystem.ViewModels.ElectionScheduleViewModel
@{ ViewBag.Title = "Edit election schedule"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4"><h2>Edit election schedule</h2><p class="text-muted">@Model.Title. Set applications to the current time to begin testing immediately; phases still advance automatically from these dates.</p>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ElectionId) @Html.ValidationSummary(true,"",new{@class="text-danger"})
<div class="card"><div class="card-body"><div class="row g-3"><div class="col-md-6">@Html.LabelFor(x=>x.NominationOpensAt)@Html.TextBoxFor(x=>x.NominationOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6">@Html.LabelFor(x=>x.NominationClosesAt)@Html.TextBoxFor(x=>x.NominationClosesAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6">@Html.LabelFor(x=>x.CampaignOpensAt)@Html.TextBoxFor(x=>x.CampaignOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6">@Html.LabelFor(x=>x.VotingOpensAt)@Html.TextBoxFor(x=>x.VotingOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6">@Html.LabelFor(x=>x.VotingClosesAt)@Html.TextBoxFor(x=>x.VotingClosesAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6">@Html.LabelFor(x=>x.ResultsPublicationAt)@Html.TextBoxFor(x=>x.ResultsPublicationAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div></div><button class="btn btn-danger mt-4">Save schedule</button> <a class="btn btn-outline-secondary mt-4" href="@Url.Action("Details",new{id=Model.ElectionId})">Cancel</a></div></div>}</div>
