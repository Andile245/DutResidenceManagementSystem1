@model DUTResManagementSystem.ViewModels.ElectionSetupViewModel
@{ ViewBag.Title="Create election"; Layout="~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4"><h2>Create residence election</h2><p class="text-muted">Create a draft, check its schedule, then publish it when it is ready.</p>@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.ValidationSummary(true,"",new {@class="text-danger"})<div class="card"><div class="card-body"><div class="row g-3"><div class="col-md-6">@Html.LabelFor(x=>x.Title)@Html.TextBoxFor(x=>x.Title,new{@class="form-control"})</div><div class="col-md-6"><label>Residence</label>@Html.DropDownListFor(x=>x.ResidenceID,(SelectList)ViewBag.Residences,"Select residence",new{@class="form-select"})</div><div class="col-12"><label>House Committee positions (comma separated)</label>@Html.TextBoxFor(x=>x.Positions,new{@class="form-control"})</div><div class="col-md-6"><label>Applications open</label>@Html.TextBoxFor(x=>x.NominationOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Applications close / review begins</label>@Html.TextBoxFor(x=>x.NominationClosesAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Campaign opens / review closes</label>@Html.TextBoxFor(x=>x.CampaignOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Voting opens</label>@Html.TextBoxFor(x=>x.VotingOpensAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Voting closes</label>@Html.TextBoxFor(x=>x.VotingClosesAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Results publication</label>@Html.TextBoxFor(x=>x.ResultsPublicationAt,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div><div class="col-md-6"><label>Minimum turnout % (optional)</label>@Html.TextBoxFor(x=>x.MinimumTurnoutPercentage,new{@class="form-control",type="number",min="0",max="100",step="0.1"})</div><div class="col-12"><label>@Html.CheckBoxFor(x=>x.PreventSelfVote) Prevent applicants from voting for themselves</label></div></div><button class="btn btn-danger mt-4">Save draft</button></div></div>}</div>
