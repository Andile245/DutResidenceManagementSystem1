@model DUTResManagementSystem.ViewModels.NominationInputViewModel
@{ ViewBag.Title="Apply for House Committee"; Layout="~/Views/Shared/_Layout.cshtml"; var election=ViewBag.Election as DUTResManagementSystem.Models.ResidenceElection; }
<div class="container py-4"><h2>Apply for a House Committee position</h2><p class="text-muted">Choose the position you want to serve in. Your residence allocation and eligibility are checked automatically before your application is reviewed.</p>@using(Html.BeginForm("Apply","Election",new{id=election.ResidenceElectionID},FormMethod.Post,new{enctype="multipart/form-data"})){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new{@class="text-danger"})<div class="card"><div class="card-body"><div class="mb-3"><label>House Committee position</label>@Html.DropDownListFor(x=>x.ElectionPositionID,(SelectList)ViewBag.Positions,"Choose the position you are applying for",new{@class="form-select"})</div><div class="mb-3"><label>Your manifesto and goals</label>@Html.TextAreaFor(x=>x.Manifesto,5,1,new{@class="form-control",placeholder="Describe your goals and plans for the residence."})</div><div class="mb-3"><label>Why should you be selected?</label>@Html.TextAreaFor(x=>x.Motivation,4,1,new{@class="form-control"})</div><div class="mb-3"><label>Campaign image (optional, JPG/PNG, max 2 MB)</label><input class="form-control" type="file" name="profilePhoto" accept="image/png,image/jpeg"/></div><div class="form-check">@Html.CheckBoxFor(x=>x.AcceptedElectionRules,new{@class="form-check-input"}) <label class="form-check-label" for="AcceptedElectionRules">I accept the residence election rules.</label></div><button class="btn btn-danger mt-3">Submit application</button></div></div>}</div>
