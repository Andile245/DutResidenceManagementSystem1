@model DUTResManagementSystem.ViewModels.ElectionDashboardViewModel
@{ ViewBag.Title = "Election Accountability Report"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4"><div class="d-print-none mb-3"><button class="btn btn-primary" onclick="window.print()">Print report</button></div><h2>Election Accountability Report</h2><p>@Model.Election.Title - @Model.Election.Residence.Name</p><p>Results published: @(Model.Election.ResultsPublishedAt.HasValue ? Model.Election.ResultsPublishedAt.Value.ToString("dd MMM yyyy HH:mm") : "Not recorded")</p><table class="table"><tr><th>Eligible voters</th><td>@Model.EligibleVoters</td></tr><tr><th>Participants</th><td>@Model.BallotsCast</td></tr><tr><th>Turnout</th><td>@Model.Turnout%</td></tr><tr><th>Applications / approved</th><td>@Model.Nominations / @Model.ApprovedCandidates</td></tr></table><h4>Audit entries</h4><ul>@foreach(var item in Model.AuditLogs){<li>@item.OccurredAt.ToString("dd MMM yyyy HH:mm") - @item.EventType: @item.Detail</li>}</ul></div>
